<!--
    液态透明玻璃主题：设置页使用浅底和蓝绿色强调色，右键菜单保留深色配色。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色设置页与透明玻璃共用蓝绿色强调色，菜单保留独立的深色配色。 -->
    <SolidColorBrush x:Key="UiPageBgBrush" Color="#F6F8F6" />
    <SolidColorBrush x:Key="UiSidebarBgBrush" Color="#EDF2EF" />
    <SolidColorBrush x:Key="UiTabSelectedBrush" Color="#DCECEA" />
    <SolidColorBrush x:Key="UiContentBgBrush" Color="#F9FBF8" />
    <SolidColorBrush x:Key="UiCardBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="UiCardBorderBrush" Color="#D9E5E1" />
    <SolidColorBrush x:Key="UiTextPrimaryBrush" Color="#18282C" />
    <SolidColorBrush x:Key="UiTextSecondaryBrush" Color="#42565C" />
    <SolidColorBrush x:Key="UiTextTertiaryBrush" Color="#52676B" />
    <SolidColorBrush x:Key="UiAccentBrush" Color="#24676D" />
    <SolidColorBrush x:Key="UiFieldBgBrush" Color="#F0F5F2" />
    <SolidColorBrush x:Key="UiFieldBorderBrush" Color="#D3E1DC" />
    <SolidColorBrush x:Key="UiDividerBrush" Color="#DFE9E5" />
    <SolidColorBrush x:Key="UiShadowBrush" Color="#000000" />

    <!-- 右键菜单 -->
    <SolidColorBrush x:Key="MenuBgBrush" Color="#E6191E29" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="MenuFgBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="MenuFgDimBrush" Color="#8A93A6" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#CCFFFFFF" />
</ResourceDictionary>
