<!--
    液态透明玻璃主题：深色通透，和 Dock 的「液态透明玻璃」一个调子。
    设置页与右键菜单都走深色玻璃，银白文字。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设置页 -->
    <LinearGradientBrush x:Key="UiPageBgBrush" StartPoint="0,0" EndPoint="0.45,1">
        <GradientStop Color="#FF141925" Offset="0" />
        <GradientStop Color="#FF10141E" Offset="0.55" />
        <GradientStop Color="#FF0A0D14" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="UiSidebarBgBrush" Color="#5C1B2130" />
    <SolidColorBrush x:Key="UiTabSelectedBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="UiContentBgBrush" Color="#40151A26" />
    <SolidColorBrush x:Key="UiCardBgBrush" Color="#8C1C2231" />
    <SolidColorBrush x:Key="UiCardBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="UiTextPrimaryBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="UiTextSecondaryBrush" Color="#A8B0C0" />
    <SolidColorBrush x:Key="UiTextTertiaryBrush" Color="#7C8496" />
    <SolidColorBrush x:Key="UiAccentBrush" Color="#5FD2FF" />
    <!-- 次级按钮 / 下拉框这类「浅色容器」的底色与描边，两套主题各给一份，
         免得深色底下出现白底浅字 -->
    <SolidColorBrush x:Key="UiFieldBgBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="UiFieldBorderBrush" Color="#33FFFFFF" />

    <SolidColorBrush x:Key="UiDividerBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="UiShadowBrush" Color="#000000" />

    <!-- 右键菜单 -->
    <SolidColorBrush x:Key="MenuBgBrush" Color="#E6191E29" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="MenuFgBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="MenuFgDimBrush" Color="#8A93A6" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#1FFFFFFF" />
</ResourceDictionary>
