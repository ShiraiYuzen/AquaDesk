                        <Border Style="{StaticResource Card}">
                            <StackPanel Style="{StaticResource Row}">
                                <Grid>
                                    <TextBlock Text="暂停时机" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Style="{StaticResource DropdownStyle}"
                                              SelectedValue="{Binding PauseMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="不暂停（一直保持当前外观）"
                                                      Tag="{x:Static models:DockPauseMode.Never}" />
                                        <ComboBoxItem Content="其他应用成为焦点时"
                                                      Tag="{x:Static models:DockPauseMode.Unfocused}" />
                                        <ComboBoxItem Content="无边框全屏时（游戏那种）"
                                                      Tag="{x:Static models:DockPauseMode.BorderlessFullscreen}" />
                                        <ComboBoxItem Content="全屏时（含浏览器 F11）"
                                                      Tag="{x:Static models:DockPauseMode.Fullscreen}" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="暂停会停掉状态轮询、回收工作集；Dock 仍然显示，鼠标移到上面会立刻恢复"
                                           Style="{StaticResource RowHint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 关于 ==================== -->
            <TabItem Style="{StaticResource SidebarTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse Width="12.6" Height="12.6" StrokeThickness="1.2"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <Ellipse Width="1.9" Height="1.9" VerticalAlignment="Top" Margin="0,4.2,0,0"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <Rectangle Width="1.7" Height="4.4" RadiusX="0.85"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3.4"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        </Grid>
                        <TextBlock Text="关于" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,26,28,26" >

                        <TextBlock Text="关于" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="版本信息、配置存放位置与运行日志"
                                   Style="{StaticResource PageSubtitle}" />

                        <StackPanel Style="{StaticResource Section}" Margin="4,26,0,9">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="AquaDesk" Style="{StaticResource SectionHeader}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Margin="16,18,16,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="52" Height="52" CornerRadius="13">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#7FDBFF" Offset="0" />
                                                    <GradientStop Color="#2563EB" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="A" FontSize="26" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="AquaDesk" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource UiTextPrimaryBrush}" />
                                            <TextBlock Text="Windows 上的 macOS 风格桌面"
                                                       Style="{StaticResource RowHint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Style="{StaticResource Row}">
                                    <Grid>
                                        <TextBlock Text="版本" Style="{StaticResource RowLabel}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="VersionValue" Style="{StaticResource ValueLabel}"
                                                       HorizontalAlignment="Left" Margin="0,0,12,0" />
                                            <Button x:Name="CheckUpdateButton" Content="检查更新"
                                                    Padding="14,5"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="OnCheckUpdate" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="从 GitHub Releases 比对版本号，只检查不自动下载"
                                               Style="{StaticResource RowHint}" Margin="0,4,0,0" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Style="{StaticResource Row}">
                                    <Grid>
                                        <TextBlock Text="运行时" Style="{StaticResource RowLabel}" />
                                        <TextBlock x:Name="RuntimeValue" Style="{StaticResource ValueLabel}" />
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Style="{StaticResource Row}">
                                    <Grid>
                                        <TextBlock Text="配置文件" Style="{StaticResource RowLabel}" />
                                        <TextBlock x:Name="ConfigPathValue" Style="{StaticResource ValueLabel}"
                                                   MaxWidth="330" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Style="{StaticResource Section}" Margin="4,8,0,9">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="维护" Style="{StaticResource SectionHeader}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <Grid>
                                        <TextBlock Text="打开配置目录" Style="{StaticResource RowLabel}" />
                                        <Button Content="打开" Padding="16,6"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="OnOpenSettingsFolder" />
                                    </Grid>
                                    <TextBlock Text="settings.json、dock.json、launchpad.json 都在这里，改坏了删掉会重新生成"
                                               Style="{StaticResource RowHint}" Margin="0,4,96,0" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Style="{StaticResource Row}">
                                    <Grid>
                                        <TextBlock Text="运行日志" Style="{StaticResource RowLabel}" />
                                        <Button Content="打开" Padding="16,6"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="OnOpenLogFolder" />
                                    </Grid>
                                    <TextBlock Text="异常和排查信息写在 %TEMP%\AquaDesk-crash.log，最多滚动保留 512 KB"
                                               Style="{StaticResource RowHint}" Margin="0,4,96,0" />
                                </StackPanel>

                                <!-- 安装版专属：打开安装目录 + 卸载（便携版没有安装目录的概念，整块隐藏） -->
                                <StackPanel x:Name="InstallOnlySection" Visibility="Collapsed">
                                    <Border Style="{StaticResource CardDivider}" />

                                    <StackPanel Style="{StaticResource Row}">
                                        <Grid>
                                            <TextBlock Text="安装目录" Style="{StaticResource RowLabel}" />
                                            <Button Content="打开" Padding="16,6"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="OnOpenInstallFolder" />
                                        </Grid>
                                        <TextBlock Text="程序本体和 Update.exe 都在这里"
                                                   Style="{StaticResource RowHint}" Margin="0,4,96,0" />
                                    </StackPanel>

                                    <Border Style="{StaticResource CardDivider}" />

                                    <StackPanel Style="{StaticResource Row}">
                                        <Grid>
                                            <TextBlock Text="卸载 AquaDesk" Style="{StaticResource RowLabel}" />
                                            <Button Content="卸载" Padding="16,6"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="OnUninstall" />
                                        </Grid>
                                        <TextBlock Text="删除程序本体、快捷方式和所有配置数据"
                                                   Style="{StaticResource RowHint}" Margin="0,4,96,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Style="{StaticResource Section}" Margin="4,8,0,9">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="重置" Style="{StaticResource SectionHeader}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Style="{StaticResource Row}">
                                <Grid>
                                    <TextBlock Text="恢复全部设置" Style="{StaticResource RowLabel}" />
                                    <Button Content="全部重置" Padding="16,6"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnResetAll" />
                                </Grid>
                                <TextBlock Text="把外观、Dock、图标、系统一起恢复成默认值，会再确认一次。开机自启与 Dock 上的图标列表不动。"
                                           Style="{StaticResource RowHint}" Margin="0,4,96,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Border>
</Window>
