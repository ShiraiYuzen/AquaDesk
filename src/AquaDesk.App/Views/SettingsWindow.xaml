<Window x:Class="AquaDesk.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AquaDesk.Models"
        Title="AquaDesk 设置"
        Icon="pack://application:,,,/Assets/AquaDesk.ico"
        Width="880" Height="668"
        MinWidth="760" MinHeight="540"
        MaxWidth="1040" MaxHeight="860"
        Background="{DynamicResource UiPageBgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        设置页用 Windows 自己的窗口边框和标题栏 —— 拖动、最大化、贴边、快捷键全部交给系统。
        里面是「左分类 + 右卡片」：左侧五个分类，右侧按功能分组的白卡片。
        分类之外的视觉规则只有三条：节标题带一根短蓝条、卡片统一 12px 圆角 + 极淡描边、
        每一行的左右内边距一律 16。
    -->
    <Window.Resources>

        <!-- ============ 文字 ============ -->

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 节标题：3px 蓝条 + 灰色小字，比单纯一行灰字更容易被眼睛分段 -->
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="4,0,0,9" />
        </Style>

        <Style x:Key="SectionBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="11" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource UiAccentBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource UiTextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ============ 卡片 ============ -->

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource UiCardBgBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                      Opacity="0.05" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片里的每一行：左右内边距固定 16 -->
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Margin" Value="16,13,16,14" />
        </Style>

        <Style x:Key="CardDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource UiDividerBrush}" />
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <!-- ============ iOS 风格开关 ============ -->

        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="42" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="12" Background="#DDDDE3" />
                                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.22" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#34C759" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 滑块（细轨道 + 白色圆钮，替换系统那套 XP 观感） ============ -->

        <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#0A84FF"
                                VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1.2"
                                                      Opacity="0.3" Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Stroke="#D6D6DB" StrokeThickness="0.8" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#DCDCE2"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderTrackFill}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackEmpty}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 风格选择（三张可选卡片，取代 ComboBox） ============ -->

        <Style x:Key="StyleOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="12"
                                Background="#FBFBFD"
                                BorderBrush="#E7E7EE" BorderThickness="1.5"
                                Padding="14,14,14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C9C9D4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#0A84FF" />
                                <Setter TargetName="Box" Property="Background" Value="#F5FAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 按钮 ============ -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="#0A84FF"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0071E3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0063C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8"
                                Background="{DynamicResource UiFieldBgBrush}"
                                BorderBrush="{DynamicResource UiFieldBorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource UiTabSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EBEBF0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 下拉框 ============
             系统那套 ComboBox 是浅色立体样式，放进深色设置页里像块补丁，
             所以整只重画：圆角浅底 + 右侧一道细箭线，展开是一张和右键菜单同色的卡片。 -->
        <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuFgBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" CornerRadius="7" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#330A84FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DropdownStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="236" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownItem}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Box" CornerRadius="7"
                                    Background="{DynamicResource UiFieldBgBrush}"
                                    BorderBrush="{DynamicResource UiFieldBorderBrush}" BorderThickness="1" />

                            <ContentPresenter x:Name="SelectionSite" Margin="10,5,26,5"
                                              VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                            <Path Data="M0,0 L5,5 L10,0" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource UiTextSecondaryBrush}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" IsHitTestVisible="False" />

                            <!-- 整块都能点开：ToggleButton 铺在最上面，模板清空成透明 -->
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border CornerRadius="10" Padding="4" Margin="0,4,0,0"
                                        Background="{DynamicResource MenuBgBrush}"
                                        BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="3"
                                                          Opacity="0.20" Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource UiTabSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 左侧导航 ============ -->

        <Style x:Key="SidebarTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#5E5E68" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Row" CornerRadius="8" Margin="0,1"
                                Padding="9,8" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 选中态的短蓝条：不选中时占位但透明，保证文字不左右跳 -->
                                <Border x:Name="Accent" Grid.Column="0"
                                        Width="3" Height="15" CornerRadius="1.5"
                                        Background="Transparent" Margin="0,0,9,0"
                                        VerticalAlignment="Center" />

                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#12000000" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource UiTabSelectedBrush}" />
                                <Setter TargetName="Accent" Property="Background" Value="#0A84FF" />
                                <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Row" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                          Opacity="0.09" Color="#000000" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTabControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="196" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 侧栏：系统标题栏负责拖动，这里只放分类列表 -->
                            <Border Grid.Column="0" Background="{DynamicResource UiSidebarBgBrush}"
                                    BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Margin="9,12,9,12">
                                    <!-- 用 StackPanel 当 items host：TabPanel 是给横向标签条排版的，
                                         侧栏要的是竖向列表 -->
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Column="1" Background="{DynamicResource UiContentBgBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ContentPresenter Grid.Row="0" ContentSource="SelectedContent" />

                                <!-- 底部固定条：所有分页共用，不用每页都放一遍 -->
                                <Border Grid.Row="1" Background="{DynamicResource UiCardBgBrush}"
                                        BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,1,0,0"
                                        Padding="24,12,24,14">
                                    <Grid>
                                        <Button Content="恢复本页默认" Padding="16,7"
                                                HorizontalAlignment="Left"
                                                Click="OnResetDefaults">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Style.Triggers>
                                                        <!-- 「关于」页没有可恢复的项，按钮直接收起来 -->
                                                        <DataTrigger Value="4"
                                                                     Binding="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <!-- 只有真的改过设置才出现；保存完自己收起来 -->
                                            <TextBlock x:Name="SavedHint" Text="已保存" Visibility="Collapsed"
                                                       Foreground="{DynamicResource UiTextTertiaryBrush}"
                                                       FontSize="11.5" VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />
                                            <Button x:Name="SaveButton" Content="保存" Padding="22,7"
                                                    Margin="0,0,8,0" Visibility="Collapsed"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="OnSave" />
                                            <Button Content="完成" Padding="24,7"
                                                    Style="{StaticResource SecondaryButton}"
                                                    IsDefault="True"
                                                    Click="OnClose" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 普通窗口：没有外投影、没有自绘圆角，边框和标题栏都是系统的 -->
    <Border x:Name="RootCard">
        <TabControl x:Name="RootTabs"
                    Style="{StaticResource SidebarTabControl}"
                    TabStripPlacement="Left"
                    BorderThickness="0" Background="Transparent">

            <!-- ==================== 外观 ==================== -->
            <TabItem Style="{StaticResource SidebarTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Path Data="M8,2 A6,6 0 0,1 8,14 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <Ellipse Width="12.6" Height="12.6" StrokeThickness="1.2"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        </Grid>
                        <TextBlock Text="外观" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,26,28,26" >

                        <TextBlock Text="外观" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="界面风格与玻璃质感，改完立即生效，配置自动保存"
                                   Style="{StaticResource PageSubtitle}" />

                        <StackPanel Style="{StaticResource Section}" Margin="4,26,0,9">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="界面风格" Style="{StaticResource SectionHeader}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <Grid>
                                        <TextBlock Text="允许切换外观" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding AllowStyleSwitch, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="默认统一用液态透明玻璃。打开后才会出现下面的外观可选"
                                               Style="{StaticResource RowHint}" Margin="0,4,58,0" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="16,16,16,16"
                                            Visibility="{Binding AllowStyleSwitch, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">

                                        <RadioButton Style="{StaticResource StyleOption}"
                                                     GroupName="Style"
                                                     IsChecked="{Binding IsLiquidClear, Mode=OneWay}"
                                                     Click="OnStyleLiquidClear">
                                            <StackPanel Width="132">
                                                <Border Width="46" Height="46" CornerRadius="10"
                                                        HorizontalAlignment="Left"
                                                        Background="#16181F">
                                                    <Border BorderThickness="1.4" CornerRadius="9" Margin="5">
                                                        <Border.BorderBrush>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#5FD2FF" Offset="0" />
                                                                <GradientStop Color="#5FFFC8" Offset="0.35" />
                                                                <GradientStop Color="#FFE45F" Offset="0.62" />
                                                                <GradientStop Color="#FF5FD2" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.BorderBrush>
                                                    </Border>
                                                </Border>
                                                <TextBlock Text="液态透明玻璃" FontWeight="SemiBold" Margin="0,10,0,0" />
                                                <TextBlock Text="彩虹色散 · 极致通透" FontSize="11"
                                                           Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton Style="{StaticResource StyleOption}"
                                                     GroupName="Style"
                                                     IsChecked="{Binding IsClassic, Mode=OneWay}"
                                                     Click="OnStyleClassic">
                                            <StackPanel Width="132">
                                                <Border Width="46" Height="46" CornerRadius="10"
                                                        HorizontalAlignment="Left"
                                                        Background="#D8DCE4" />
                                                <TextBlock Text="经典" FontWeight="SemiBold" Margin="0,10,0,0" />
