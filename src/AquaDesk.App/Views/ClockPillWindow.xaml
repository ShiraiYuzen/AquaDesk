<Window x:Class="AquaDesk.Views.ClockPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaDesk Clock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="108" Height="46"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 播放控制按钮：22px 的圆形热区，悬停/按下各提一档亮度。
             Focusable=False —— 这个浮层本来就不该拿键盘焦点。 -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2BFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外面这圈 margin 是给阴影留的落点，窗口本身是透明的 -->
    <Grid Margin="10,6,10,10">
        <Grid x:Name="Pill" Height="30" Width="88" HorizontalAlignment="Center">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                  Opacity="0.32" Color="#000000" />
            </Grid.Effect>

            <!-- 拖动命中层：铺满整个胶囊，透明但可命中，让「可拖动」时整块都能拖。
                 放在最底层，不挡上面的文字和播放按钮。 -->
            <Rectangle Fill="Transparent" />

            <!-- ① 底色：透明度跟 Dock 走同一个设置 -->
            <Rectangle x:Name="Tint"
                       RadiusX="15" RadiusY="15"
                       Fill="{StaticResource GlassTintBrush}"
                       Opacity="{Binding TintOpacity}"
                       Visibility="{Binding ShowsTint, Converter={StaticResource BoolToVisibility}}" />

            <!-- 液态透明玻璃：极淡底色 + 顶部镜面高光 + 银白轮廓 + 细微色散 -->
            <Rectangle RadiusX="15" RadiusY="15"
                       Visibility="{Binding IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.12,1">
                        <GradientStop Color="#3D1B2540" Offset="0" />
                        <GradientStop Color="#4D121A2E" Offset="0.55" />
                        <GradientStop Color="#6605080F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle RadiusX="15" RadiusY="15"
                       Visibility="{Binding IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#8CFFFFFF" Offset="0.05" />
                        <GradientStop Color="#00FFFFFF" Offset="0.3" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle RadiusX="15" RadiusY="15" StrokeThickness="1.8"
                       Visibility="{Binding IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.1,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#7ADCE6F5" Offset="0.3" />
                        <GradientStop Color="#2690A0B8" Offset="0.75" />
                        <GradientStop Color="#40FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
            </Rectangle>

            <Rectangle RadiusX="15" RadiusY="15" StrokeThickness="0.9"
                       Visibility="{Binding IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3DFF5FD2" Offset="0" />
                        <GradientStop Color="#3D5FD2FF" Offset="0.22" />
                        <GradientStop Color="#3D5FFFC8" Offset="0.45" />
                        <GradientStop Color="#3DFFE45F" Offset="0.7" />
                        <GradientStop Color="#3DFF5FD2" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
            </Rectangle>

            <!-- ② 顶部聚光 -->
            <Rectangle RadiusX="15" RadiusY="15"
                       Fill="{StaticResource GlassTopGlowBrush}"
                       IsHitTestVisible="False" />

            <!-- ③ 顶边亮线 -->
            <Rectangle RadiusX="15" RadiusY="15"
                       Stroke="{StaticResource GlassTopRimBrush}"
                       StrokeThickness="2"
                       IsHitTestVisible="False" />

            <!-- ⑤ 底部反光 -->
            <Rectangle RadiusX="15" RadiusY="15"
                       Fill="{StaticResource GlassBottomBounceBrush}"
                       IsHitTestVisible="False" />

            <!-- ⑥ 斜向光泽 -->
            <Rectangle RadiusX="15" RadiusY="15"
                       Fill="{StaticResource GlassSheenBrush}"
                       IsHitTestVisible="False" />

            <!-- ⑦ 玻璃边缘 -->
            <Rectangle RadiusX="15" RadiusY="15"
                       Stroke="{StaticResource GlassRimBrush}"
                       StrokeThickness="1.1"
                       IsHitTestVisible="False" />

            <!-- ⑧ 底部内阴影 -->
            <Rectangle RadiusX="15" RadiusY="15"
                       Fill="{StaticResource GlassInnerShadowBrush}"
                       IsHitTestVisible="False" />

            <!-- ==================== 形态一：时间 ==================== -->
            <TextBlock x:Name="ClockText"
                       Text="--:--"
                       Foreground="{StaticResource TextOnGlassBrush}"
                       FontSize="13"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="14,0"
                       TextAlignment="Center" />

            <!-- ==================== 形态二：正在播放 ====================
                 左边是播放它那个应用的图标，中间曲名 + 歌手，右边三个自绘按钮。
                 宽度由代码按目标值补间（Pill.Width），外面窗口是 SizeToContent，会跟着一起长。 -->
            <Grid x:Name="PlayerState" Visibility="Collapsed" Margin="7,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 应用图标：取不到就退回一个音符 -->
                <Border Grid.Column="0" Width="18" Height="18"
                        CornerRadius="5" Background="#24FFFFFF"
                        VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="AppIcon" Stretch="Uniform" Margin="2"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Path x:Name="AppIconFallback"
                              Data="M7.6,1.6 L7.6,8.1 A2.1,2.1 0 1 1 6.2,6.1 L6.2,3.4 L10.2,2.6 L10.2,5.3 A2.1,2.1 0 1 1 8.8,3.4"
                              Stroke="{StaticResource TextOnGlassBrush}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,4,0">
                    <TextBlock x:Name="TrackTitle"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#FFF3F5FA"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackArtist"
                               FontSize="9" Margin="0,1,0,0"
                               Foreground="#A6F3F5FA"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 上一首 -->
                    <Button x:Name="PrevButton" Style="{StaticResource PillButton}"
                            Click="OnPrevious" ToolTip="上一首">
                        <Grid Width="11" Height="11">
                            <Rectangle Width="1.4" Height="7.6" RadiusX="0.7" RadiusY="0.7"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Fill="{StaticResource TextOnGlassBrush}" />
                            <Path Data="M9.6,2.2 L9.6,8.8 L4.4,5.5 Z"
                                  Fill="{StaticResource TextOnGlassBrush}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,1,0" />
                        </Grid>
                    </Button>

                    <!-- 播放 / 暂停：两个字形叠着，按状态切可见性 -->
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PillButton}"
                            Margin="1,0" Click="OnPlayPause" ToolTip="播放 / 暂停">
                        <Grid Width="11" Height="11">
                            <Path x:Name="PauseGlyph"
                                  Data="M2.6,2.4 L4.6,2.4 L4.6,8.6 L2.6,8.6 Z M6.4,2.4 L8.4,2.4 L8.4,8.6 L6.4,8.6 Z"
                                  Fill="{StaticResource TextOnGlassBrush}" />
                            <Path x:Name="PlayGlyph"
                                  Data="M3.2,2.2 L8.6,5.5 L3.2,8.8 Z"
                                  Fill="{StaticResource TextOnGlassBrush}"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <!-- 下一首 -->
                    <Button x:Name="NextButton" Style="{StaticResource PillButton}"
                            Click="OnNext" ToolTip="下一首">
                        <Grid Width="11" Height="11">
                            <Path Data="M1.4,2.2 L1.4,8.8 L6.6,5.5 Z"
                                  Fill="{StaticResource TextOnGlassBrush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="1,0,0,0" />
                            <Rectangle Width="1.4" Height="7.6" RadiusX="0.7" RadiusY="0.7"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Fill="{StaticResource TextOnGlassBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
