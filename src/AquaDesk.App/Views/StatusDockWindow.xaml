<Window x:Class="AquaDesk.Views.StatusDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AquaDesk.Views"
        Title="AquaDesk Status"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="179"
        Height="130"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- ============ 电源菜单 ============
             原来挂在 Dock 最左边的 Windows 图标上，现在入口搬到状态胶囊。
             和 DockWindow 里那份同一套样式：单行模板 + 白色圆角卡片（系统模板左边会空出一大块）。 -->
        <Style x:Key="PowerMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" CornerRadius="8" Background="Transparent" Padding="10,8">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="PowerMenu" x:Shared="False"
                     Placement="Top"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     FontFamily="Microsoft YaHei UI"
                     ItemContainerStyle="{StaticResource PowerMenuItemStyle}">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="12" Padding="6"
                            CornerRadius="14"
                            Background="#FAFFFFFF"
                            BorderBrush="#1A000000" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="5"
                                              Opacity="0.22" Color="#000000" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>

            <MenuItem Click="OnPowerLock">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Stroke="#3A3A3C" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"
                              Data="M8,10.5V8a4,4 0 0 1 8,0v2.5 M6.6,10.5h10.8a1.6,1.6 0 0 1 1.6,1.6v6.3a1.6,1.6 0 0 1-1.6,1.6H6.6A1.6,1.6 0 0 1 5,18.4v-6.3a1.6,1.6 0 0 1 1.6-1.6z" />
                        <TextBlock Text="锁定" Margin="11,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Click="OnPowerSleep">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Stroke="#3A3A3C" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"
                              Data="M20.2,14.6A8.6,8.6 0 0 1 9.4,3.8 8.6,8.6 0 1 0 20.2,14.6z" />
                        <TextBlock Text="睡眠" Margin="11,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Click="OnPowerShutdown">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Stroke="#3A3A3C" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"
                              Data="M12,3.4v8.2 M7.3,6.5a7.2,7.2 0 1 0 9.4,0" />
                        <TextBlock Text="关机" Margin="11,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Click="OnPowerRestart">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18">
                            <Path Stretch="Uniform"
                                  Stroke="#3A3A3C" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M13.3,4.5A7.6,7.6 0 1 1 4.9,9.4" />
                            <Path Fill="#3A3A3C" Data="M12.6,1.9 L17.4,4.5 L12.6,7.1 Z" />
                        </Grid>
                        <TextBlock Text="重启" Margin="11,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid>
    <!-- 阴影落点 -->
    <Grid Margin="10,6,10,10">
        <Grid x:Name="Pill">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                  Opacity="0.32" Color="#000000" />
            </Grid.Effect>

            <!-- ① 底色 -->
            <Rectangle x:Name="Tint"
                       RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Fill="{StaticResource GlassTintBrush}"
                       Opacity="{Binding TintOpacity}"
                       Visibility="{Binding ShowsTint, Converter={StaticResource BoolToVisibility}}" />

            <!-- 液态透明玻璃：极淡底色 + 顶部镜面高光 + 银白轮廓 + 细微色散 -->
            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Visibility="{Binding IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.12,1">
                        <GradientStop Color="#3D1B2540" Offset="0" />
                        <GradientStop Color="#4D121A2E" Offset="0.55" />
                        <GradientStop Color="#6605080F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Visibility="{Binding IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#8CFFFFFF" Offset="0.05" />
                        <GradientStop Color="#00FFFFFF" Offset="0.3" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}" StrokeThickness="1.8"
                       Visibility="{Binding IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.1,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#7ADCE6F5" Offset="0.3" />
                        <GradientStop Color="#2690A0B8" Offset="0.75" />
                        <GradientStop Color="#40FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
            </Rectangle>

            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}" StrokeThickness="0.9"
                       Visibility="{Binding IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3DFF5FD2" Offset="0" />
                        <GradientStop Color="#3D5FD2FF" Offset="0.22" />
                        <GradientStop Color="#3D5FFFC8" Offset="0.45" />
                        <GradientStop Color="#3DFFE45F" Offset="0.7" />
                        <GradientStop Color="#3DFF5FD2" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
            </Rectangle>

            <!-- ② 顶部聚光 -->
            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Fill="{StaticResource GlassTopGlowBrush}"
                       IsHitTestVisible="False" />

            <!-- ③ 顶边亮线 -->
            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Stroke="{StaticResource GlassTopRimBrush}"
                       StrokeThickness="2"
                       IsHitTestVisible="False" />

            <!-- ⑤ 底部反光 -->
            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Fill="{StaticResource GlassBottomBounceBrush}"
                       IsHitTestVisible="False" />

            <!-- ⑥ 斜向光泽 -->
            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Fill="{StaticResource GlassSheenBrush}"
                       IsHitTestVisible="False" />

            <!-- ⑦ 玻璃边缘 -->
            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Stroke="{StaticResource GlassRimBrush}"
                       StrokeThickness="1.1"
                       IsHitTestVisible="False" />

            <!-- ⑧ 底部内阴影 -->
            <Rectangle RadiusX="{Binding CornerRadius}" RadiusY="{Binding CornerRadius}"
                       Fill="{StaticResource GlassInnerShadowBrush}"
                       IsHitTestVisible="False" />

            <!-- 图标行：上排 5 项、下排 4 项，共用一套 27px 列网格
                 以前每项各自带 margin，宽窄不一（电量那块最宽），两排又各自居中，
                 结果排成了两套间距，上下看着参差。现在列宽写死、图标在格内居中。
                 上下两排各自按内容宽严格居中，压在胶囊同一条中心线上。 -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="12,0">

                <!-- 上排：设置 / Windows / 后台程序 / 电量(跨2格) / WiFi -->
                <Grid x:Name="TopRow" Height="16" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="27" />
                    </Grid.ColumnDefinitions>

                    <!-- 设置入口：点开设置。0.3.11 从 Dock 搬进胶囊，0.4.0 挪到最前面；
                         0.4.9 起开关 ShowBrandIcon 也管这一格的显隐（Dock 上不再摆） -->
                    <Grid x:Name="BrandIcon" Grid.Column="0"
                          Width="16" Height="9.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Cursor="Hand"
                          ToolTip="AquaDesk 设置"
                          Visibility="{Binding ShowBrandIcon, Converter={StaticResource BoolToVisibility}}"
                          MouseLeftButtonUp="OnBrandClick">
                        <Rectangle Fill="Transparent" />
                        <!-- 玻璃胶囊（描边）+ 三个点，跟 Dock 那块品牌图标的造型对齐 -->
                        <Border CornerRadius="4.75"
                                BorderBrush="{StaticResource TextOnGlassBrush}"
                                BorderThickness="1.05" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="2.1" Height="2.1"
                                     Fill="{StaticResource TextOnGlassBrush}" Margin="0,0,1.7,0" />
                            <Ellipse Width="2.1" Height="2.1"
                                     Fill="{StaticResource TextOnGlassBrush}" Margin="0,0,1.7,0" />
                            <Ellipse Width="2.1" Height="2.1"
                                     Fill="{StaticResource TextOnGlassBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Windows 入口：左键弹电源菜单（同上，显隐由 ShowWindowsIcon 管） -->
                    <Grid x:Name="WindowsIcon" Grid.Column="1"
                          Width="14" Height="13"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Cursor="Hand"
                          ToolTip="电源"
                          Visibility="{Binding ShowWindowsIcon, Converter={StaticResource BoolToVisibility}}"
                          MouseLeftButtonUp="OnWindowsClick">
                        <Rectangle Fill="Transparent" />
                        <!-- 四个方块：左上最亮、右下略暗，和 Dock 上那块图标同一套光感 -->
                        <UniformGrid Rows="2" Columns="2"
                                     Width="12.4" Height="12.4"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Margin="0.6" CornerRadius="0.9"
                                    Background="{StaticResource TextOnGlassBrush}" Opacity="0.97" />
                            <Border Margin="0.6" CornerRadius="0.9"
                                    Background="{StaticResource TextOnGlassBrush}" Opacity="0.88" />
                            <Border Margin="0.6" CornerRadius="0.9"
                                    Background="{StaticResource TextOnGlassBrush}" Opacity="0.88" />
                            <Border Margin="0.6" CornerRadius="0.9"
                                    Background="{StaticResource TextOnGlassBrush}" Opacity="0.78" />
                        </UniformGrid>
                    </Grid>

                    <!-- 后台程序：枚举最小化窗口 + 托盘登记表，不是系统托盘本身 -->
                    <Grid x:Name="BackgroundIcon" Grid.Column="2"
                          Width="14" Height="13"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Cursor="Hand"
                          ToolTip="后台程序"
                          Visibility="{Binding ShowBackgroundAppsButton, Converter={StaticResource BoolToVisibility}}"
                          MouseLeftButtonUp="OnBackgroundClick">
                        <Rectangle Fill="Transparent" />
                        <Path Data="M1,4.6 H9.4 A1,1 0 0 1 10.4,5.6 V11 A1,1 0 0 1 9.4,12 H1 A1,1 0 0 1 0,11 V5.6 A1,1 0 0 1 1,4.6 Z"
                              Stroke="{StaticResource TextOnGlassBrush}" StrokeThickness="1.1"
                              Fill="Transparent" />
                        <Path Data="M3.6,4.6 V2.6 A1.1,1.1 0 0 1 4.7,1.5 H13 A1,1 0 0 1 14,2.5 V8 A1,1 0 0 1 13,9 H10.4"
                              Stroke="{StaticResource TextOnGlassBrush}" StrokeThickness="1.1"
                              Fill="Transparent" />
                    </Grid>

                    <!-- 电量：电池 + 百分比，这块要装两格 -->
                    <StackPanel x:Name="BatteryPanel" Grid.Column="3" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="22" Height="11" VerticalAlignment="Center">
                            <Border CornerRadius="3.2"
                                    BorderBrush="#8CFFFFFF"
                                    BorderThickness="1" />

                            <Border x:Name="BatteryFill"
                                    CornerRadius="2"
                                    Background="#F2FFFFFF"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Margin="2"
                                    Width="0" />

                            <!-- 充电闪电压在填充层上，和 macOS 一致 -->
                            <Path x:Name="ChargeBolt"
                                  Data="M12,1.2 L9,6.4 L11.6,6.4 L10.1,10.9 L15,5.6 L12.2,5.6 Z"
                                  Fill="#14161A"
                                  Visibility="Collapsed" />
                        </Grid>

                        <!-- 百分比默认不显示（和 macOS 一样只画电池），开关在设置 → 图标 → 状态胶囊 -->
                        <TextBlock x:Name="BatteryText"
                                   Text="--"
                                   Foreground="{StaticResource TextOnGlassBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   MinWidth="24"
                                   Visibility="{Binding ShowBatteryPercent, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- WiFi -->
                    <Grid x:Name="WifiIcon" Grid.Column="5"
                          Width="16" Height="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Cursor="Hand"
                          ToolTip="WiFi"
                          MouseLeftButtonUp="OnNetworkClick">
                        <Path x:Name="WifiWave3"
                              Data="M1.5,5.2 A11,11 0 0 1 15.5,5.2"
                              Stroke="{StaticResource TextOnGlassBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent" />
                        <Path x:Name="WifiWave2"
                              Data="M4.4,8.2 A7,7 0 0 1 12.6,8.2"
                              Stroke="{StaticResource TextOnGlassBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent" />
                        <Ellipse x:Name="WifiDot"
                                 Width="2.4" Height="2.4"
                                 Fill="{StaticResource TextOnGlassBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,1" />
                        <Line x:Name="WifiSlash"
                              X1="2" Y1="11" X2="14" Y2="1"
                              Stroke="{StaticResource TextOnGlassBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- 下排：蓝牙 / 音量 / 输入法状态 / 键盘布局
                     按自身内容宽在胶囊里严格居中，和上排共用同一条中心线 -->
                <Grid x:Name="BottomRow" Height="16" HorizontalAlignment="Center" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="27" />
                    </Grid.ColumnDefinitions>

                    <!-- 蓝牙 -->
                    <Grid x:Name="BluetoothIcon" Grid.Column="0"
                          Width="12" Height="13"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Cursor="Hand"
                          ToolTip="蓝牙"
                          MouseLeftButtonUp="OnBluetoothClick">
                        <Path x:Name="BluetoothGlyph"
                              Data="M6.5,1 L6.5,13 M6.5,1 L10,3.8 L3,10.2 M6.5,13 L10,10.2 L3,3.8"
                              Stroke="{StaticResource TextOnGlassBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="12" Height="13" />
                    </Grid>

                    <!-- 音量 -->
                    <Grid x:Name="VolumeIcon" Grid.Column="1"
                          Width="16" Height="13"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Cursor="Hand"
                          ToolTip="音量"
                          MouseLeftButtonUp="OnVolumeClick">
                        <Path Data="M1.5,4.6 L4.2,4.6 L7.5,1.6 L7.5,11.4 L4.2,8.4 L1.5,8.4 Z"
                              Fill="{StaticResource TextOnGlassBrush}" />
                        <Path x:Name="VolumeWave1"
                              Data="M10,4.2 A4.2,4.2 0 0 1 10,9.2"
                              Stroke="{StaticResource TextOnGlassBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent" />
                        <Path x:Name="VolumeWave2"
                              Data="M12,2.2 A7.2,7.2 0 0 1 12,11.2"
                              Stroke="{StaticResource TextOnGlassBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent" />
                    </Grid>

                    <!-- 输入法状态（中 / 英）：它和后面的键盘布局本来就是两个信息，
                         拆成两格后各自落在网格上，切换输入法也不会再把整行挤歪 -->
                    <Grid x:Name="InputArea" Grid.Column="2"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          MinWidth="11"
                          Cursor="Hand"
                          ToolTip="键盘布局"
                          MouseLeftButtonUp="OnInputClick">
                        <Rectangle Fill="Transparent" />
                        <TextBlock x:Name="InputStateText"
                                   Text="中"
                                   Foreground="{StaticResource TextOnGlassBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   MinWidth="11"
                                   TextAlignment="Center" />
                    </Grid>

                    <!-- 键盘布局：取得到 IME 图标就用图标，取不到退回 EN 文字 -->
                    <Grid x:Name="LayoutArea" Grid.Column="3"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Cursor="Hand"
                          ToolTip="键盘布局"
                          MouseLeftButtonUp="OnInputClick">
                        <Rectangle Fill="Transparent" />
                        <Image x:Name="InputGlyph"
                               Width="14" Height="14"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="InputText"
                                   Text="EN"
                                   Foreground="{StaticResource TextOnGlassBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- 面板从胶囊上方弹出（原来在顶栏是往下弹，现在位置换了，方向也要反） -->
    <Popup x:Name="PanelPopup"
           StaysOpen="True"
           AllowsTransparency="True"
           Placement="Absolute"
           PopupAnimation="Fade">
        <Border Background="#F21A1D24"
                CornerRadius="15"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.5" />
            </Border.Effect>

            <views:MenuBarPanel x:Name="MenuPanel" />
        </Border>
    </Popup>
    </Grid>
</Window>
