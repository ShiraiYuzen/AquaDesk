<Window x:Class="AquaDesk.Views.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AquaDesk.Views"
        Title="AquaDesk MenuBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E61C2028" Offset="0" />
                <GradientStop Color="#CC12151B" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 底部一条细高光，模拟菜单栏的下边缘 -->
        <Border Height="1" VerticalAlignment="Bottom" Background="#1FFFFFFF" />

        <!-- ============ 左侧：logo + 当前应用 ============ -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="14,0,0,0"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnBrandClick">

            <Viewbox Width="13" Height="13">
                <Grid Width="100" Height="100">
                    <Border CornerRadius="23.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7EE0FF" Offset="0" />
                                <GradientStop Color="#2563EB" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Width="60" Height="19" CornerRadius="9.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#B8FFFFFF" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="2" Background="White" Margin="0,0,3,0" />
                        <Border Width="8" Height="8" CornerRadius="2" Background="White" Margin="0,0,3,0" />
                        <Border Width="8" Height="8" CornerRadius="2" Background="White" />
                    </StackPanel>
                </Grid>
            </Viewbox>

            <TextBlock x:Name="AppNameText"
                       Text="AquaDesk"
                       Foreground="#F2FFFFFF"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="9,0,0,0" />
        </StackPanel>

        <!-- ============ 右侧：托盘 / 电量 / WiFi / 音量 / 输入法 / 时钟 ============ -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0">

            <!-- 系统托盘（放在右侧最左边，就像把底部托盘搬到顶上来） -->
            <Border x:Name="TrayIcon"
                    Width="26" Height="18"
                    CornerRadius="5"
                    Background="#1FFFFFFF"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Cursor="Hand"
                    ToolTip="系统托盘"
                    MouseLeftButtonUp="OnTrayClick">
                <Path Data="M0,0 L4.6,4.2 L9.2,0"
                      Stroke="#F2FFFFFF"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>

            <!-- 电量 -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Grid Width="24" Height="12" VerticalAlignment="Center">
                    <Border CornerRadius="3.5"
                            BorderBrush="#8CFFFFFF"
                            BorderThickness="1" />

                    <Border x:Name="BatteryFill"
                            CornerRadius="2"
                            Background="#F2FFFFFF"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Margin="2"
                            Width="0" />

                    <!-- 充电闪电：macOS 的做法是黑色闪电压在电池填充上，不是摆在电池外面 -->
                    <Path x:Name="ChargeBolt"
                          Data="M12,1.2 L9,6.4 L11.6,6.4 L10.1,10.9 L15,5.6 L12.2,5.6 Z"
                          Fill="#14161A"
                          Visibility="Collapsed" />
                </Grid>

                <TextBlock x:Name="BatteryText"
                           Text="--"
                           Foreground="#F2FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           MinWidth="26" />
            </StackPanel>

            <!-- WiFi -->
            <Grid x:Name="WifiIcon"
                  Width="17" Height="13"
                  VerticalAlignment="Center"
                  Margin="0,0,16,0"
                  Cursor="Hand"
                  MouseLeftButtonUp="OnNetworkClick">
                <Path x:Name="WifiWave3"
                      Data="M1.5,5.2 A11,11 0 0,1 15.5,5.2"
                      Stroke="#F2FFFFFF" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" />
                <Path x:Name="WifiWave2"
                      Data="M4.4,8.2 A7,7 0 0,1 12.6,8.2"
                      Stroke="#F2FFFFFF" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" />
                <Ellipse x:Name="WifiDot"
                         Width="2.6" Height="2.6"
                         Fill="#F2FFFFFF"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,1" />

                <!-- 未连接时盖一条斜线 -->
                <Line x:Name="WifiSlash"
                      X1="2" Y1="12" X2="15" Y2="1"
                      Stroke="#F2FFFFFF" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Visibility="Collapsed" />
            </Grid>

            <!-- 蓝牙（在 WiFi 右边） -->
            <Grid x:Name="BluetoothIcon"
                  Width="13" Height="14"
                  VerticalAlignment="Center"
                  Margin="0,0,16,0"
                  Cursor="Hand"
                  ToolTip="蓝牙"
                  MouseLeftButtonUp="OnBluetoothClick">
                <Path x:Name="BluetoothGlyph"
                      Data="M6.5,1 L6.5,13 M6.5,1 L10,3.8 L3,10.2 M6.5,13 L10,10.2 L3,3.8"
                      Stroke="#F2FFFFFF"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="13" Height="14" />
            </Grid>

            <!-- 音量 -->
            <Grid x:Name="VolumeIcon"
                  Width="17" Height="14"
                  VerticalAlignment="Center"
                  Margin="0,0,16,0"
                  Cursor="Hand"
                  MouseLeftButtonUp="OnVolumeClick">
                <Path Data="M1.5,5 L4.5,5 L8,1.8 L8,12.2 L4.5,9 L1.5,9 Z"
                      Fill="#F2FFFFFF" />
                <Path x:Name="VolumeWave1"
                      Data="M10.6,4.4 A4.4,4.4 0 0,1 10.6,9.6"
                      Stroke="#F2FFFFFF" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" />
                <Path x:Name="VolumeWave2"
                      Data="M12.8,2.2 A7.6,7.6 0 0,1 12.8,11.8"
                      Stroke="#F2FFFFFF" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" />
            </Grid>

            <!-- 输入法 / 键盘布局：有图标的显示图标，没有的（美式键盘）退回文字 -->
            <StackPanel x:Name="InputArea"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        MinWidth="18"
                        Cursor="Hand"
                        ToolTip="键盘布局"
                        MouseLeftButtonUp="OnInputClick">

                <!-- 中 / 英 / A：只在中文键盘下显示，英文键盘直接收起来 -->
                <TextBlock x:Name="InputStateText"
                           Text="中"
                           Foreground="#E6FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           MinWidth="12"
                           TextAlignment="Center" />

                <Image x:Name="InputGlyph"
                       Width="15" Height="15"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock x:Name="InputText"
                           Text="EN"
                           Foreground="#F2FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- 时钟 -->
            <TextBlock x:Name="ClockText"
                       Text="--:--"
                       Foreground="#F2FFFFFF"
                       FontSize="12.5"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       VerticalAlignment="Center" />
        </StackPanel>
        <Popup x:Name="PanelPopup"
           StaysOpen="True"
           AllowsTransparency="True"
           Placement="Absolute"
           PopupAnimation="Fade">
        <Border Background="#F21A1D24"
                CornerRadius="15"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                Padding="12"
                Margin="0,6,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.5" />
            </Border.Effect>

            <views:MenuBarPanel x:Name="MenuPanel" />
        </Border>
        </Popup>
    </Grid>
</Window>
