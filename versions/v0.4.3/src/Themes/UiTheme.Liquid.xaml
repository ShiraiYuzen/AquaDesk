<!--
    液态玻璃主题：浅色磨砂，和 Dock 的液态玻璃一个调子。
    只放"颜色"这一层，控件模板在 UiControls.xaml 里，靠 DynamicResource 取这里的键，
    所以换主题只需要换这一份字典。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设置页 -->
    <LinearGradientBrush x:Key="UiPageBgBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#FFFDFEFF" Offset="0" />
        <GradientStop Color="#FFF1F5FB" Offset="0.55" />
        <GradientStop Color="#FFE7EEF8" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="UiSidebarBgBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="UiTabSelectedBrush" Color="#7AFFFFFF" />
    <SolidColorBrush x:Key="UiContentBgBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="UiCardBgBrush" Color="#E8FFFFFF" />
    <SolidColorBrush x:Key="UiCardBorderBrush" Color="#7AFFFFFF" />
    <SolidColorBrush x:Key="UiTextPrimaryBrush" Color="#17171B" />
    <SolidColorBrush x:Key="UiTextSecondaryBrush" Color="#83838C" />
    <SolidColorBrush x:Key="UiTextTertiaryBrush" Color="#9A9AA2" />
    <SolidColorBrush x:Key="UiAccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="UiDividerBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="UiShadowBrush" Color="#000000" />

    <!-- 右键菜单 -->
    <SolidColorBrush x:Key="MenuBgBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#3D000000" />
    <SolidColorBrush x:Key="MenuFgBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="MenuFgDimBrush" Color="#8E8E96" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#1F000000" />
</ResourceDictionary>
