<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 带 Windows SDK 版本号才能用 Windows.Devices.Radios（Wi-Fi 开关走的是它，
         旧的 WlanSetInterface 射频接口在 Killer 这类网卡上直接返回 87） -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>AquaDesk</RootNamespace>
    <AssemblyName>AquaDesk</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon，比手写 Shell_NotifyIcon 省事 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFAC010：WinForms 分析器要求把 DPI 设置挪到 ApplicationHighDpiMode，
         但这是 WPF 应用，DPI 感知在 app.manifest 里声明（PerMonitorV2），不需要它 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 版本号 0.4.3：显示用 0.4.3，程序集/文件版本必须是纯数字四段，取 0.4.3.0 -->
    <Version>0.4.3</Version>
    <AssemblyVersion>0.4.3.0</AssemblyVersion>
    <FileVersion>0.4.3.0</FileVersion>
    <InformationalVersion>0.4.3</InformationalVersion>

    <Product>AquaDesk</Product>
    <AssemblyTitle>AquaDesk 水光桌面</AssemblyTitle>
    <Company>AquaDesk</Company>
    <ApplicationIcon>Assets\AquaDesk.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!-- 单文件发布默认参数，dotnet publish 时不必再写一长串 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 开了 UseWindowsForms 后 SDK 会把 System.Drawing / System.Windows.Forms 塞进隐式 using，
         跟 WPF 的 Color / Point / MouseEventArgs 全面撞名，这里去掉，需要的地方显式 using -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- 设置页标题栏也要用这个图标，所以额外打包成 WPF 资源 -->
    <Resource Include="Assets\AquaDesk.ico" />
  </ItemGroup>

</Project>
