<Window x:Class="AquaDesk.Views.DockFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件夹"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        AllowDrop="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- 视觉完全照搬启动台：同一套暗色径向底、7 列网格、122×136 的格子、
         悬停高亮、74px 图标 + 12px 名字。改启动台外观时记得同步这里。 -->

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          Drop="OnDropFiles"
          DragOver="OnDragOverFiles">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.32" GradientOrigin="0.5,0.32" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#F01B1F27" Offset="0" />
                <GradientStop Color="#F00A0B0E" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="60,32,60,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 顶栏：退出 + 标题 + 搜索 ============ -->
            <Grid Grid.Row="0" Margin="0,6,0,18">
                <Button x:Name="ExitButton"
                        Content="退出 (esc)"
                        Cursor="Hand"
                        ToolTip="关闭"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="OnExitClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="9" Background="#26FFFFFF" Padding="14,8">
                                <ContentPresenter TextBlock.Foreground="#F2FFFFFF"
                                                  TextBlock.FontSize="12.5"
                                                  HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Width="360" Height="42"
                        CornerRadius="11"
                        Background="#2EFFFFFF"
                        BorderBrush="#3DFFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="搜索"
                                   Foreground="#66FFFFFF"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   IsHitTestVisible="False" />

                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F2FFFFFF"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 Margin="15,0,15,0"
                                 CaretBrush="White"
                                 TextChanged="OnSearchChanged" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 内容网格 ============ -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <ItemsControl x:Name="ItemGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="122" Height="136"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      ToolTip="{Binding Name}"
                                      HorizontalAlignment="Center"
                                      MouseLeftButtonUp="OnEntryClick">

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="打开" Click="OnMenuOpenEntry" />
                                            <Separator />
                                            <MenuItem Header="从文件夹移除" Click="OnMenuRemoveEntry" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Border CornerRadius="16" Margin="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1FFFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Height="74" Width="74">
                                            <Image Source="{Binding Icon}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#F2FFFFFF"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,10,0,0"
                                                   MaxWidth="112" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="这个文件夹还是空的 —— 把文件或程序拖进来"
                           Foreground="#80FFFFFF"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />

                <TextBlock x:Name="NoResultHint"
                           Text="没有匹配的内容"
                           Foreground="#80FFFFFF"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
            </Grid>

            <!-- ============ 底部：标题 + 数量 ============ -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock x:Name="TitleText"
                           Foreground="#F2FFFFFF"
                           FontSize="17"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CountText"
                           Foreground="#8CFFFFFF"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
