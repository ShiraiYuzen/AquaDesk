<UserControl x:Class="AquaDesk.Views.MenuBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="4,10,0,6" />
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- macOS 的列表行：圆角更大、悬停很淡，不用硬分隔线 -->
                        <Border x:Name="Bg" CornerRadius="9" Background="Transparent" Padding="9,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部那种「文字链接」按钮，macOS 里就长这样：没有底色和边框 -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="6,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- macOS 那种胶囊开关，Wi-Fi 和蓝牙共用 -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11" Background="#2EFFFFFF"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0A84FF" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00000000" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="308">
        <!-- ================= Wi-Fi 列表 ================= -->
        <StackPanel x:Name="WifiView" Visibility="Collapsed">
            <!-- 标题两行：主标题 + 当前状态，和 macOS 系统设置里的 Wi-Fi 一致 -->
            <Grid Margin="6,0,6,10">
                <StackPanel>
                    <TextBlock Text="Wi-Fi" Foreground="#F2FFFFFF" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="WifiStatusText" Text="正在扫描…"
                               Foreground="#8CFFFFFF" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>

                <ToggleButton x:Name="WifiSwitch" Style="{StaticResource SwitchToggle}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                              ToolTip="Wi-Fi 开关" Click="OnWifiSwitchClick" />
            </Grid>

            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="WifiList" />
            </ScrollViewer>

            <TextBlock x:Name="WifiEmptyText" Text="正在扫描…" Foreground="#66FFFFFF"
                       FontSize="12" Margin="4,12,0,12" Visibility="Collapsed" />

            <!-- macOS 不用分隔线，靠留白分组 -->
            <Grid Margin="0,10,0,0">
                <Button Content="更多 Wi-Fi 设置" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Click="OnMoreWifiClick" />

                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Click="OnWifiRefreshClick" ToolTip="重新扫描">
                    <TextBlock Text="↻" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#E6FFFFFF" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- ================= 蓝牙 ================= -->
        <StackPanel x:Name="BluetoothView" Visibility="Collapsed">
            <Grid Margin="6,0,6,10">
                <StackPanel>
                    <TextBlock Text="蓝牙" Foreground="#F2FFFFFF" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="BluetoothStatusText" Text="正在读取…"
                               Foreground="#8CFFFFFF" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>

                <ToggleButton x:Name="BluetoothSwitch" Style="{StaticResource SwitchToggle}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                              ToolTip="蓝牙开关" Click="OnBluetoothSwitchClick" />
            </Grid>

            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="已保存的设备" Style="{StaticResource SectionLabel}" Margin="6,0,0,6" />
                    <StackPanel x:Name="PairedList" />

                    <TextBlock Text="新设备" Style="{StaticResource SectionLabel}" Margin="6,10,0,6" />
                    <StackPanel x:Name="NewDeviceList" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="BluetoothEmptyText" Text="没有找到蓝牙设备" Foreground="#66FFFFFF"
                       FontSize="12" Margin="6,6,0,6" Visibility="Collapsed" />

            <Grid Margin="0,10,0,0">
                <Button Content="更多蓝牙设置" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Click="OnMoreBluetoothClick" />

                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Click="OnBluetoothRefreshClick" ToolTip="重新搜索">
                    <TextBlock Text="↻" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="#E6FFFFFF" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- ================= Wi-Fi 密码 ================= -->
        <StackPanel x:Name="WifiPasswordView" Visibility="Collapsed">
            <Button Content="←  返回" Style="{StaticResource RowButton}" HorizontalAlignment="Left"
                    Padding="6,4" Click="OnWifiBackClick" />

            <TextBlock x:Name="WifiPasswordTitle" Foreground="#F2FFFFFF" FontSize="13.5"
                       Margin="4,8,0,0" TextWrapping="Wrap" />

            <Grid Margin="4,10,4,0">
                <PasswordBox x:Name="WifiPasswordBox"
                             Padding="10,8"
                             Background="#1FFFFFFF"
                             BorderBrush="#33FFFFFF"
                             BorderThickness="1"
                             Foreground="#F2FFFFFF"
                             CaretBrush="White"
                             PasswordChanged="OnWifiPasswordChanged" />

                <TextBlock x:Name="WifiPasswordPlaceholder"
                           Text="请输入 Wi-Fi 密码"
                           Foreground="#59FFFFFF"
                           FontSize="12.5"
                           Margin="13,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <TextBlock x:Name="WifiErrorText" Foreground="#FF6B6B" FontSize="11.5"
                       Margin="4,6,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="取消" Style="{StaticResource RowButton}" Padding="14,6"
                        Click="OnWifiBackClick" />
                <Button Content="连接" Style="{StaticResource RowButton}" Padding="18,6"
                        Background="#0A84FF" Click="OnWifiConnectClick" />
            </StackPanel>
        </StackPanel>

        <!-- ================= 键盘布局 ================= -->
        <StackPanel x:Name="KeyboardView" Visibility="Collapsed">
            <Grid Margin="4,0,4,6">
                <TextBlock Text="键盘布局" Foreground="#F2FFFFFF" FontSize="13.5" FontWeight="SemiBold" />

                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#1FFFFFFF" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="Win + 空格" Foreground="#8CFFFFFF" FontSize="10.5" />
                </Border>
            </Grid>

            <!-- 输入法可能有好几个（微软拼音 / 搜狗 / 讯飞 / 微信…），超过 5 行就滚动，
                 不然面板会一路长到屏幕外 -->
            <ScrollViewer MaxHeight="248" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="KeyboardList" />
            </ScrollViewer>

            <Border Height="1" Background="#1FFFFFFF" Margin="0,8,0,0" />

            <Button Content="更多键盘设置" Style="{StaticResource RowButton}"
                    HorizontalAlignment="Left" Margin="0,4,0,0" Padding="4,6"
                    Click="OnMoreKeyboardClick" />
        </StackPanel>

        <!-- ================= 音量 ================= -->
        <StackPanel x:Name="VolumeView" Visibility="Collapsed">
            <TextBlock Text="输出" Style="{StaticResource SectionLabel}" Margin="4,0,0,4" />
            <StackPanel x:Name="OutputList" />

            <TextBlock Text="输入" Style="{StaticResource SectionLabel}" />
            <StackPanel x:Name="InputList" />

            <Border Height="1" Background="#1FFFFFFF" Margin="0,10,0,10" />

            <Grid Margin="4,0,4,2">
                <TextBlock Text="音量" Foreground="#F2FFFFFF" FontSize="12.5" />
                <TextBlock x:Name="VolumePercentText" Text="--%"
                           Foreground="#8CFFFFFF" FontSize="12"
                           HorizontalAlignment="Right" />
            </Grid>

            <Grid x:Name="VolumeBar" Height="22" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="OnVolumeBarDown"
                  MouseMove="OnVolumeBarMove"
                  MouseLeftButtonUp="OnVolumeBarUp">
                <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                <Border x:Name="VolumeFill" Height="4" CornerRadius="2" Background="#F2FFFFFF"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                <Ellipse x:Name="VolumeKnob" Width="12" Height="12" Fill="White"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Margin="-6,0,0,0" />
            </Grid>
        </StackPanel>

        <!-- ================= 后台程序 ================= -->
        <StackPanel x:Name="BackgroundView" Visibility="Collapsed">
            <Grid Margin="4,2,4,0">
                <TextBlock Text="后台程序" Foreground="#F2FFFFFF" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="BackgroundCount" Text=""
                           Foreground="#8CFFFFFF" FontSize="11.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="BackgroundHint" Text="正在读取…"
                       Foreground="#8CFFFFFF" FontSize="11"
                       Margin="4,3,4,2" TextWrapping="Wrap" />

            <ScrollViewer MaxHeight="368" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,4,0,0">
                <StackPanel x:Name="BackgroundList" />
            </ScrollViewer>

            <Border Height="1" Background="#1FFFFFFF" Margin="0,8,0,6" />

            <Grid>
                <Button Content="刷新" Style="{StaticResource LinkButton}"
                        Foreground="#0A84FF" HorizontalAlignment="Left"
                        Click="OnBackgroundRefresh" />
                <TextBlock Text="点一行切回程序，托盘程序只能结束"
                           Foreground="#66FFFFFF" FontSize="10.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
            </Grid>
        </StackPanel>

    </Grid>
</UserControl>
