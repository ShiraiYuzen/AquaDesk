<Window x:Class="AquaDesk.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Width="470"
        SizeToContent="Height"
        MaxHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="#0A84FF"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0071E3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0063C8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#2F6FA8" />
                                <Setter Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="#33FFFFFF"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细进度条：默认那个绿色块和这套深色界面完全不搭 -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="#0A84FF" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2" Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 和设置页、输入框同一套「浮起来的小卡片」：无边框 + 圆角 + 投影 -->
    <Border Margin="14" CornerRadius="12"
            Background="{DynamicResource UiPageBgBrush}"
            BorderThickness="1"
            BorderBrush="#33FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270"
                              Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 抬头：图标 + 标题 + 版本对比 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" MouseLeftButtonDown="OnDragArea">
                <Border Width="44" Height="44" CornerRadius="11" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5AC8FA" Offset="0" />
                            <GradientStop Color="#0A84FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="GlyphText" Text="↑" FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="发现新版本"
                               FontSize="15.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource UiTextPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText" Text=""
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource UiTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- 更新内容（只有「有新版」时才显示） -->
            <Border x:Name="NotesBox" Grid.Row="1" Visibility="Collapsed"
                    Margin="0,16,0,0" CornerRadius="9" Padding="2"
                    Background="#0F000000"
                    BorderThickness="1" BorderBrush="#22FFFFFF">
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                               FontSize="12.2" LineHeight="19"
                               Foreground="{DynamicResource UiTextSecondaryBrush}" />
                </ScrollViewer>
            </Border>

            <!-- 下载进度 / 错误信息 -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0">
                <Grid>
                    <TextBlock x:Name="ProgressLabel" Text="准备下载…"
                               FontSize="11.5"
                               Foreground="{DynamicResource UiTextSecondaryBrush}" />
                    <TextBlock x:Name="ProgressPercent" Text=""
                               FontSize="11.5" HorizontalAlignment="Right"
                               Foreground="{DynamicResource UiTextSecondaryBrush}" />
                </Grid>
                <ProgressBar x:Name="DownloadBar" Style="{StaticResource ThinProgress}"
                             Minimum="0" Maximum="1" Value="0" Margin="0,7,0,0" />
            </StackPanel>

            <!-- 底部按钮 -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <CheckBox x:Name="SkipCheck" Content="跳过这个版本"
                          VerticalAlignment="Center" FontSize="11.5"
                          Foreground="{DynamicResource UiTextSecondaryBrush}"
                          Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PageButton" Content="打开发布页" Padding="14,7" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="OnOpenPage" />
                    <Button x:Name="DiagButton" Content="复制诊断信息" Padding="14,7" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="OnCopyDiagnostics" />
                    <Button x:Name="CancelButton" Content="取消" Padding="18,7" Margin="0,0,8,0"
                            Style="{StaticResource DialogSecondaryButton}"
                            Click="OnCancel" />
                    <Button x:Name="UpdateButton" Content="下载并安装" Padding="20,7" Visibility="Collapsed"
                            Style="{StaticResource DialogPrimaryButton}"
                            Click="OnUpdate" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
