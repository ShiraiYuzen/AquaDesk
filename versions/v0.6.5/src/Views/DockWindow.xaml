<Window x:Class="AquaDesk.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaDesk Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        AllowDrop="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Dock 上所有「字形类」图标（Windows / 我的电脑 / 废纸篓）共用的底板：
             和启动台那块浅色圆角砖同一套渐变 + 左上柔光，保证和整块画的应用图标观感一致。
             内容是一层 Viewbox，字形放进来后统一缩到磁贴的 58%。 -->
        <ControlTemplate x:Key="IconTileTemplate" TargetType="ContentControl">
            <Viewbox Stretch="Uniform">
                <Grid Width="100" Height="100">
                    <Border CornerRadius="23.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FBFCFD" Offset="0" />
                                <GradientStop Color="#CFD4DB" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border CornerRadius="23.5">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.3,0.18" Center="0.3,0.18"
                                                 RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#4DFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Viewbox>
        </ControlTemplate>

        <!-- 三类图标各自的右键菜单。x:Shared="False" 保证每个图标拿到独立实例，
             菜单项里的 {Binding IsRunning} 才会跟着各自的 DataContext 走。 -->
        <ContextMenu x:Key="AppIconMenu" x:Shared="False" Opened="OnMenuOpened">
            <MenuItem Header="打开" Click="OnMenuOpen" />
            <MenuItem Header="关闭应用" Click="OnMenuCloseApp"
                      IsEnabled="{Binding IsRunning}" />
            <Separator />
            <MenuItem Header="添加应用…" Click="OnMenuAdd" />
            <MenuItem Header="新建文件夹" Click="OnMenuNewFolder" />
            <MenuItem Header="移除此图标" Click="OnMenuRemove" />
        </ContextMenu>

        <!-- 用户新建的文件夹：里面能放程序，也能放文件 -->
        <ContextMenu x:Key="FolderIconMenu" x:Shared="False" Opened="OnMenuOpened">
            <MenuItem Header="打开文件夹" Click="OnOpenFolder" />
            <Separator />
            <MenuItem Header="重命名" Click="OnRenameFolder" />
            <MenuItem Header="添加文件…" Click="OnMenuAddToFolder" />
            <MenuItem Header="新建文件夹" Click="OnMenuNewFolder" />
            <MenuItem Header="移除此文件夹" Click="OnMenuRemove" />
        </ContextMenu>

        <ContextMenu x:Key="ComputerIconMenu" x:Shared="False" Opened="OnMenuOpened">
            <MenuItem Header="打开我的电脑" Click="OnOpenComputer" />
            <Separator />
            <MenuItem Header="Dock 设置…" Click="OnOpenSettings" />
            <MenuItem Header="退出 AquaDesk" Click="OnExitApp" />
        </ContextMenu>

        <!-- 窗口预览：只做「切过去 / 关掉」，别把应用菜单套上去（里面的移除会算错索引） -->
        <ContextMenu x:Key="WindowPreviewMenu" x:Shared="False" Opened="OnMenuOpened">
            <MenuItem Header="切换到该窗口" Click="OnActivateWindow" />
            <Separator />
            <MenuItem Header="关闭窗口" Tag="close" Click="OnCloseWindow" />
        </ContextMenu>

        <ContextMenu x:Key="BrandIconMenu" x:Shared="False" Opened="OnMenuOpened">
            <MenuItem Header="Dock 设置…" Click="OnOpenSettings" />
            <Separator />
            <MenuItem Header="退出 AquaDesk" Click="OnExitApp" />
        </ContextMenu>

        <ContextMenu x:Key="TrashIconMenu" x:Shared="False" Opened="OnMenuOpened">
            <MenuItem Header="打开废纸篓" Click="OnOpenTrash" />
            <MenuItem Header="关闭应用" Click="OnMenuCloseApp"
                      IsEnabled="{Binding IsRunning}" />
            <Separator />
            <MenuItem Header="清空废纸篓" Click="OnEmptyTrash" />
        </ContextMenu>

        <ContextMenu x:Key="LaunchpadIconMenu" x:Shared="False" Opened="OnMenuOpened">
            <MenuItem Header="打开启动台" Click="OnMenuLaunchpad" />
            <Separator />
            <MenuItem Header="Dock 设置…" Click="OnOpenSettings" />
            <MenuItem Header="退出 AquaDesk" Click="OnExitApp" />
        </ContextMenu>

        <!-- ============ 电源菜单（左键点 Windows 图标弹出） ============
             系统默认的 MenuItem 模板带勾选栏和图标栏，左边会空出一大块。
             这里换成单行模板：只有内容 + hover 高亮，外面套一张白色圆角卡片。 -->
        <Style x:Key="PowerMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" CornerRadius="8" Background="Transparent" Padding="10,8">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="PowerMenu" x:Shared="False"
                     Placement="Top"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     FontFamily="Microsoft YaHei UI"
                     ItemContainerStyle="{StaticResource PowerMenuItemStyle}">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Margin 是给阴影留的位置，不然 DropShadow 会被弹出窗口裁掉 -->
                    <Border Margin="12" Padding="6"
                            CornerRadius="14"
                            Background="#FAFFFFFF"
                            BorderBrush="#1A000000" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="5"
                                              Opacity="0.22" Color="#000000" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>

            <!-- 图标统一 18×18 细线条，和 macOS 那张电源菜单一个气质 -->
            <MenuItem Click="OnPowerLock">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Stroke="#3A3A3C" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"
                              Data="M8,10.5V8a4,4 0 0 1 8,0v2.5 M6.6,10.5h10.8a1.6,1.6 0 0 1 1.6,1.6v6.3a1.6,1.6 0 0 1-1.6,1.6H6.6A1.6,1.6 0 0 1 5,18.4v-6.3a1.6,1.6 0 0 1 1.6-1.6z" />
                        <TextBlock Text="锁定" Margin="11,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Click="OnPowerSleep">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Stroke="#3A3A3C" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"
                              Data="M20.2,14.6A8.6,8.6 0 0 1 9.4,3.8 8.6,8.6 0 1 0 20.2,14.6z" />
                        <TextBlock Text="睡眠" Margin="11,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Click="OnPowerShutdown">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Stroke="#3A3A3C" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"
                              Data="M12,3.4v8.2 M7.3,6.5a7.2,7.2 0 1 0 9.4,0" />
                        <TextBlock Text="关机" Margin="11,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Click="OnPowerRestart">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18">
                            <Path Stretch="Uniform"
                                  Stroke="#3A3A3C" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M13.3,4.5A7.6,7.6 0 1 1 4.9,9.4" />
                            <!-- 箭头：顺着圆弧起点的切线方向，指出去 -->
                            <Path Fill="#3A3A3C" Data="M12.6,1.9 L17.4,4.5 L12.6,7.1 Z" />
                        </Grid>
                        <TextBlock Text="重启" Margin="11,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>
        <!-- 液态透明玻璃的「流动曲面」：让斜向柔光缓慢来回平移，像液体表面在流。
             由 ApplyStyle 控制开关，其它样式下不跑，免得白烧 CPU。 -->
        <Storyboard x:Key="FlowStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <PointAnimation Storyboard.TargetName="FlowBrush"
                            Storyboard.TargetProperty="StartPoint"
                            From="0,0" To="0.5,0.42" Duration="0:0:14" />
            <PointAnimation Storyboard.TargetName="FlowBrush"
                            Storyboard.TargetProperty="EndPoint"
                            From="1,1" To="1.5,1.42" Duration="0:0:14" />
        </Storyboard>
    </Window.Resources>

    <Grid VerticalAlignment="{Binding Settings.DockVerticalAlignment}"
          HorizontalAlignment="{Binding Settings.DockHorizontalAlignment}"
          Margin="{Binding Settings.EdgeMarginThickness}">

        <Grid x:Name="GlassRoot"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="Transparent"
              MouseMove="OnSurfaceMouseMove"
              MouseLeave="OnSurfaceMouseLeave">

            <!-- 右键空白处 -->
            <Grid.ContextMenu>
                <ContextMenu Opened="OnMenuOpened">
                    <MenuItem Header="添加应用…" Click="OnMenuAdd" />
                    <MenuItem Header="新建文件夹" Click="OnMenuNewFolder" />
                    <Separator />
                    <MenuItem Header="Dock 设置…" Click="OnOpenSettings" />
                    <MenuItem Header="退出 AquaDesk" Click="OnExitApp" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- ⓿ 折射层：Dock 背后的真实画面，边缘被"玻璃"弯折 -->
            <Rectangle x:Name="RefractionLayer"
                       RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Visibility="{Binding Settings.IsLiquid, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <ImageBrush x:Name="RefractionBrush" Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>

            <!-- ① 底色 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Fill="{StaticResource GlassTintBrush}"
                       Opacity="{Binding Settings.TintOpacity}"
                       Visibility="{Binding Settings.ShowsTint, Converter={StaticResource BoolToVisibility}}" />

            <!-- ===== 液态透明玻璃：几乎无底色，靠镜面高光 + 焦散线 + 极淡色散成形 ===== -->

            <!-- ⑨ 底色：只是一层极淡的暗调，主要通透感靠折射 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Visibility="{Binding Settings.IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.12,1">
                        <GradientStop Color="#3D1B2540" Offset="0" />
                        <GradientStop Color="#4D121A2E" Offset="0.55" />
                        <GradientStop Color="#6605080F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ⑩ 顶部镜面高光：贴着顶边的一道极亮的细光，往下 20% 内化开 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Visibility="{Binding Settings.IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#8CFFFFFF" Offset="0.035" />
                        <GradientStop Color="#26FFFFFF" Offset="0.12" />
                        <GradientStop Color="#00FFFFFF" Offset="0.26" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ⑪ 焦散线 A：斜向一道窄亮带，像光被玻璃聚成的亮线 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Visibility="{Binding Settings.IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.75,1">
                        <GradientStop Color="#00FFFFFF" Offset="0.28" />
                        <GradientStop Color="#59FFFFFF" Offset="0.46" />
                        <GradientStop Color="#00FFFFFF" Offset="0.54" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ⑫ 焦散线 B：另一道更淡的，制造厚度 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Visibility="{Binding Settings.IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.2,1" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0.58" />
                        <GradientStop Color="#33FFFFFF" Offset="0.74" />
                        <GradientStop Color="#00FFFFFF" Offset="0.86" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ⑬ 柔和轮廓光：银白细边，上亮下暗（不是一圈等亮的描边） -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       StrokeThickness="1.8"
                       Visibility="{Binding Settings.IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.1,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#7ADCE6F5" Offset="0.3" />
                        <GradientStop Color="#2690A0B8" Offset="0.75" />
                        <GradientStop Color="#40FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
            </Rectangle>

            <!-- ⑭ 细小彩虹色散：只在下半圈边缘透出一点点 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       StrokeThickness="0.9"
                       Visibility="{Binding Settings.IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3DFF5FD2" Offset="0" />
                        <GradientStop Color="#3D5FD2FF" Offset="0.22" />
                        <GradientStop Color="#3D5FFFC8" Offset="0.45" />
                        <GradientStop Color="#3DFFE45F" Offset="0.7" />
                        <GradientStop Color="#3DFF5FD2" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Stroke>
            </Rectangle>

            <!-- ⑮ 流动曲面：斜向柔光缓慢平移，像液体表面在流 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Opacity="0.35"
                       Visibility="{Binding Settings.IsLiquidClear, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="FlowBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#2EFFFFFF" Offset="0.32" />
                        <GradientStop Color="#00FFFFFF" Offset="0.58" />
                        <GradientStop Color="#1FFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ② 顶部聚光：光从上方压下来，在顶边内侧积成一团 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Fill="{StaticResource GlassTopGlowBrush}"
                       Visibility="{Binding Settings.IsLiquid, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False" />

            <!-- ③ 顶边亮线：玻璃"反光"最关键的那一道 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Stroke="{StaticResource GlassTopRimBrush}"
                       StrokeThickness="2.4"
                       Visibility="{Binding Settings.IsLiquid, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False" />

            <!-- ④ 跟随鼠标的镜面反光：像光在玻璃上滑动 -->
            <Rectangle x:Name="PointerGlow"
                       RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Opacity="0.22"
                       Visibility="{Binding Settings.IsLiquid, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush x:Name="PointerGlowBrush"
                                         Center="0.5,0.62" GradientOrigin="0.5,0.62"
                                         RadiusX="0.20" RadiusY="1.25">
                        <GradientStop Color="#73FFFFFF" Offset="0" />
                        <GradientStop Color="#3DFFFFFF" Offset="0.4" />
                        <GradientStop Color="#0FFFFFFF" Offset="0.72" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ⑤ 底部反光：光穿透玻璃后从底边弹回来的一层微光 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Fill="{StaticResource GlassBottomBounceBrush}"
                       Visibility="{Binding Settings.IsLiquid, Converter={StaticResource BoolToVisibility}}"
                       IsHitTestVisible="False" />

            <!-- ⑥ 斜向光泽 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Fill="{StaticResource GlassSheenBrush}"
                       IsHitTestVisible="False" />

            <!-- ⑦ 玻璃边缘 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Stroke="{StaticResource GlassRimBrush}"
                       StrokeThickness="1.2"
                       IsHitTestVisible="False" />

            <!-- ⑧ 底部内阴影：给玻璃一点厚度 -->
            <Rectangle RadiusX="{Binding Settings.CornerRadius}"
                       RadiusY="{Binding Settings.CornerRadius}"
                       Fill="{StaticResource GlassInnerShadowBrush}"
                       IsHitTestVisible="False" />

            <!-- 图标行：前两个固定是 AquaDesk 自己和启动台（在 Items 里，但标记为 Pinned），
                 后面才是用户图标 -->
            <StackPanel Orientation="{Binding Settings.DockPanelOrientation}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="{Binding Settings.DockPaddingThickness}">

                <ItemsControl x:Name="DockItems"
                              ItemsSource="{Binding Items}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 容器宽度 = 图标行宽度，最后一个图标紧贴玻璃条内缘，末端不留空白 -->
                        <StackPanel Orientation="{Binding DataContext.Settings.DockPanelOrientation,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="IconRoot"
                              Margin="{Binding DataContext.Settings.IconMarginThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Background="Transparent"
                              ToolTip="{Binding Name}"
                              Cursor="Hand"
                              RenderTransformOrigin="{Binding DataContext.Settings.IconTransformOrigin,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              PreviewMouseLeftButtonDown="OnItemMouseDown"
                              MouseLeftButtonUp="OnItemClick">

                            <!-- 菜单按图标类型切换：应用 / 品牌 / 启动台 -->
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Width"
                                            Value="{Binding DataContext.Settings.ScaledIconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <Setter Property="Height"
                                            Value="{Binding DataContext.Settings.ScaledIconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <Setter Property="ContextMenu" Value="{StaticResource AppIconMenu}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrand}" Value="True">
                                            <Setter Property="ContextMenu" Value="{StaticResource BrandIconMenu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLaunchpad}" Value="True">
                                            <Setter Property="ContextMenu" Value="{StaticResource LaunchpadIconMenu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsWindows}" Value="True">
                                            <Setter Property="ContextMenu" Value="{StaticResource BrandIconMenu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsComputer}" Value="True">
                                            <Setter Property="ContextMenu" Value="{StaticResource ComputerIconMenu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="ContextMenu" Value="{StaticResource FolderIconMenu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsWindowPreview}" Value="True">
                                            <Setter Property="ContextMenu" Value="{StaticResource WindowPreviewMenu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTrash}" Value="True">
                                            <Setter Property="ContextMenu" Value="{StaticResource TrashIconMenu}" />
                                        </DataTrigger>
                                        <!-- 分隔线不需要那么宽 -->
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter Property="Width" Value="13" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </DataTrigger>

                                        <!-- 竖排时分隔线：格子要撑到图标宽（横线 34 长才放得下），
                                             高度压成一条细缝。必须放在上面那条之后 —— 触发器后写的赢。 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSeparator}" Value="True" />
                                                <Condition Binding="{Binding DataContext.Settings.IsVertical,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Width"
                                                    Value="{Binding DataContext.Settings.ScaledIconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            <Setter Property="Height" Value="13" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- ============ 应用图标 ============ -->
                            <Grid Visibility="{Binding IsApp, Converter={StaticResource BoolToVisibility}}">

                                <!-- 兜底：图标实在取不到（exe 被占用 / 商店应用 / 路径已失效）时
                                     显示名字首字，别留一个看不懂的空格子 -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="CornerRadius"
                                                    Value="{Binding DataContext.Settings.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            <Setter Property="Background" Value="#2EFFFFFF" />
                                            <Setter Property="BorderBrush" Value="#3DFFFFFF" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Initial}"
                                               FontWeight="SemiBold"
                                               Foreground="#E6FFFFFF"
                                               FontSize="{Binding DataContext.Settings.PlusFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- 底板：整块画时为 null（不画）；圆形/字形图标时用图标自己的颜色补满圆角方形 -->
                                <Rectangle RadiusX="{Binding DataContext.Settings.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           RadiusY="{Binding DataContext.Settings.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Fill="{Binding PlateBrush}" />

                                <!-- 铺满：图标裁成圆角方形顶满磁贴，透明处露出底板 -->
                                <Rectangle RadiusX="{Binding DataContext.Settings.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           RadiusY="{Binding DataContext.Settings.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Fill}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- 内嵌：透明底的字形图标，缩进一圈放在对比色底板上 -->
                                <Image Source="{Binding Icon}"
                                       Stretch="Uniform"
                                       Margin="{Binding DataContext.Settings.IconInsetThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Inset}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>

                            <!-- ============ 品牌图标（纯矢量，任何尺寸都清晰） ============ -->
                            <Viewbox Stretch="Uniform"
                                     Visibility="{Binding IsBrand, Converter={StaticResource BoolToVisibility}}">
                                <Grid Width="100" Height="100">
                                    <Border CornerRadius="23.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7EE0FF" Offset="0" />
                                                <GradientStop Color="#2563EB" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- 左上柔光 -->
                                    <Border CornerRadius="23.5">
                                        <Border.Background>
                                            <RadialGradientBrush GradientOrigin="0.28,0.22"
                                                                 Center="0.28,0.22"
                                                                 RadiusX="0.85" RadiusY="0.85">
                                                <GradientStop Color="#5CFFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- 玻璃胶囊 -->
                                    <Border Width="66" Height="21" CornerRadius="10.5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#B8FFFFFF" />

                                    <!-- 三个图标位 -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="9" Height="9" CornerRadius="2.2"
                                                Background="#FFFFFFFF" Margin="0,0,4,0" />
                                        <Border Width="9" Height="9" CornerRadius="2.2"
                                                Background="#FFFFFFFF" Margin="0,0,4,0" />
                                        <Border Width="9" Height="9" CornerRadius="2.2"
                                                Background="#FFFFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <!-- ============ 启动台（3×3 彩色点阵） ============ -->
                            <Viewbox Stretch="Uniform"
                                     Visibility="{Binding IsLaunchpad, Converter={StaticResource BoolToVisibility}}">
                                <Grid Width="100" Height="100">
                                    <Border CornerRadius="23.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FBFCFD" Offset="0" />
                                                <GradientStop Color="#CFD4DB" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Border CornerRadius="23.5">
                                        <Border.Background>
                                            <RadialGradientBrush GradientOrigin="0.3,0.18"
                                                                 Center="0.3,0.18"
                                                                 RadiusX="0.9" RadiusY="0.9">
                                                <GradientStop Color="#4DFFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <UniformGrid Rows="3" Columns="3"
                                                 Width="68" Height="68"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Background="#FF6B6B" CornerRadius="5" Margin="2.2" />
                                        <Border Background="#FFB84D" CornerRadius="5" Margin="2.2" />
                                        <Border Background="#FFD93D" CornerRadius="5" Margin="2.2" />
                                        <Border Background="#6BCB77" CornerRadius="5" Margin="2.2" />
                                        <Border Background="#4D96FF" CornerRadius="5" Margin="2.2" />
                                        <Border Background="#9B5DE5" CornerRadius="5" Margin="2.2" />
                                        <Border Background="#F15BB5" CornerRadius="5" Margin="2.2" />
                                        <Border Background="#00BBF9" CornerRadius="5" Margin="2.2" />
                                        <Border Background="#8D99AE" CornerRadius="5" Margin="2.2" />
                                    </UniformGrid>
                                </Grid>
                            </Viewbox>

                            <!-- ============ Windows 菜单（四个方块，纯矢量） ============ -->
                            <ContentControl Template="{StaticResource IconTileTemplate}"
                                            Visibility="{Binding IsWindows, Converter={StaticResource BoolToVisibility}}">
                                <Viewbox Width="72" Height="72">
                                    <UniformGrid Rows="2" Columns="2" Width="100" Height="100">
                                        <!-- 左上最亮，右下最深，跟 Win11 官方标志的光感一致 -->
                                        <Border CornerRadius="4" Margin="3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#66D2F7" Offset="0" />
                                                    <GradientStop Color="#2AA9E8" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="4" Margin="3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2AA9E8" Offset="0" />
                                                    <GradientStop Color="#1583CE" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="4" Margin="3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2AA9E8" Offset="0" />
                                                    <GradientStop Color="#1583CE" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="4" Margin="3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1E93D9" Offset="0" />
                                                    <GradientStop Color="#0B6FBA" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </UniformGrid>
                                </Viewbox>
                            </ContentControl>

                            <!-- ============ 我的电脑（显示器，纯矢量） ============ -->
                            <ContentControl Template="{StaticResource IconTileTemplate}"
                                            Visibility="{Binding IsComputer, Converter={StaticResource BoolToVisibility}}">
                                <Viewbox Width="78" Height="78">
                                    <Grid Width="100" Height="100">
                                        <!-- 外框 -->
                                        <Border Width="86" Height="60" CornerRadius="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,6,0,0" Background="#39424F" />

                                        <!-- 屏幕 -->
                                        <Border Width="78" Height="52" CornerRadius="3"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,10,0,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                                                    <GradientStop Color="#7FE6FF" Offset="0" />
                                                    <GradientStop Color="#3BB6F0" Offset="0.45" />
                                                    <GradientStop Color="#1877D2" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- 屏幕左上角高光 -->
                                        <Border Width="78" Height="52" CornerRadius="3"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,10,0,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,0.75">
                                                    <GradientStop Color="#66FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- 支架 -->
                                        <Border Width="8" Height="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,66,0,0" Background="#7C8798" />

                                        <!-- 底座 -->
                                        <Border Width="42" Height="7" CornerRadius="3.5"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,79,0,0" Background="#98A3B3" />
                                    </Grid>
                                </Viewbox>
                            </ContentControl>

                            <!-- ============ 文件夹（2×2 缩略图，跟启动台的文件夹一致） ============ -->
                            <Viewbox Stretch="Uniform"
                                     Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}">
                                <Grid Width="100" Height="100">
                                    <!-- 底板跟 IconTileTemplate 同一套，圆角比例才对得上 -->
                                    <Border CornerRadius="23.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FBFCFD" Offset="0" />
                                                <GradientStop Color="#CFD4DB" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Thumbnails}" Margin="13">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="2" Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Icon}"
                                                       Margin="3"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 空文件夹：画个文件夹轮廓，不然就是个白方块 -->
                                    <Viewbox Stretch="Uniform" Width="68" Height="68"
                                             Visibility="{Binding IsEmptyFolder, Converter={StaticResource BoolToVisibility}}">
                                        <Path Width="24" Height="24" Stretch="Uniform"
                                              Stroke="#8A93A0" StrokeThickness="1.6"
                                              StrokeLineJoin="Round"
                                              Fill="#26FFFFFF"
                                              Data="M3,7.5a2,2 0 0 1 2-2h4.6l2.2,2.6H19a2,2 0 0 1 2,2v8.4a2,2 0 0 1-2,2H5a2,2 0 0 1-2-2z" />
                                    </Viewbox>
                                </Grid>
                            </Viewbox>

                            <!-- ============ 窗口预览（缩略图贴在圆角砖里） ============ -->
                            <Viewbox Stretch="Uniform"
                                     Visibility="{Binding IsWindowPreview, Converter={StaticResource BoolToVisibility}}">
                                <Grid Width="100" Height="64">
                                    <!-- 占位底：还没抓到图、或者窗口抓不了（提权/DRM）时露出来 -->
                                    <Border CornerRadius="9" Background="#3DFFFFFF"
                                            BorderBrush="#33FFFFFF" BorderThickness="1.5" />

                                    <!-- 兜底：抓不到缩略图就显示应用图标 -->
                                    <Image Source="{Binding Icon}"
                                           Width="42" Height="42"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <Border CornerRadius="8" Margin="1.5">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}"
                                                        Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>

                                    <Border CornerRadius="9" BorderBrush="#4DFFFFFF" BorderThickness="1.5" />

                                    <!-- 同应用多窗口角标：合并了 N 个窗口时右上角显示 N -->
                                    <Border CornerRadius="6.5" Width="13" Height="13"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,1.5,1.5,0"
                                            Background="#E6343E4A"
                                            BorderBrush="#66FFFFFF" BorderThickness="1"
                                            Visibility="{Binding ShowWindowCount,
                                                         Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding WindowCount}"
                                                   FontSize="8.5" FontWeight="Bold"
                                                   Foreground="#FFF3F5FA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Viewbox>

                            <!-- ============ 分隔线 ============ -->
                            <Grid Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibility}}">
                                <Border CornerRadius="0.75"
                                        Background="#59FFFFFF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="{Binding DataContext.Settings.SeparatorWidth,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Height="{Binding DataContext.Settings.SeparatorHeight,
                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </Grid>

                            <!-- ============ 废纸篓（矢量） ============ -->
                            <ContentControl Template="{StaticResource IconTileTemplate}"
                                            Visibility="{Binding IsTrash, Converter={StaticResource BoolToVisibility}}">
                                <Viewbox Width="90" Height="90">
                                    <Grid Width="100" Height="100">
                                        <!-- 提手 -->
                                        <Path Data="M38,26 L38,18 Q38,13 43,13 L57,13 Q62,13 62,18 L62,26"
                                              Stroke="#7D8794" StrokeThickness="6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Fill="Transparent" />

                                        <!-- 盖子 -->
                                        <Border Height="10"
                                                VerticalAlignment="Top"
                                                Margin="13,22,13,0"
                                                CornerRadius="5"
                                                Background="#B9C2CD" />

                                        <!-- 桶身：白砖上要压得住，所以整体比原来深一档 -->
                                        <Path Data="M20,34 L80,34 L72,88 Q71,94 65,94 L35,94 Q29,94 28,88 Z">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFFFFF" Offset="0" />
                                                    <GradientStop Color="#98A3B0" Offset="0.45" />
                                                    <GradientStop Color="#D2D9E1" Offset="1" />
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>

                                        <!-- 桶身边缘 -->
                                        <Path Data="M20,34 L80,34 L72,88 Q71,94 65,94 L35,94 Q29,94 28,88 Z"
                                              Stroke="#8B95A2" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" Fill="Transparent" />

                                        <!-- 竖纹 -->
                                        <Line X1="40" Y1="46" X2="42" Y2="82" Stroke="#6B7480" StrokeThickness="3" Opacity="0.4" />
                                        <Line X1="50" Y1="46" X2="50" Y2="82" Stroke="#6B7480" StrokeThickness="3" Opacity="0.4" />
                                        <Line X1="60" Y1="46" X2="58" Y2="82" Stroke="#6B7480" StrokeThickness="3" Opacity="0.4" />
                                    </Grid>
                                </Viewbox>
                            </ContentControl>

                            <!-- 运行指示：图标正下方一根胶囊条，落在 Dock 的内边距里。
                                 只变长度不变粗细；出现/消失/长短切换都走动画，避免生硬跳变 -->
                            <Rectangle x:Name="RunIndicator"
                                       RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,-7.5"
                                       Fill="#CC1C1C1E">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Width" Value="13" />
                                        <Setter Property="Height" Value="4" />
                                        <Setter Property="Opacity" Value="0" />

                                        <Style.Triggers>
                                            <!-- 竖排：整条转成竖的（宽度/高度对调）。
                                                 不用 RotateTransform —— Freezable 不在可视树里，
                                                 RelativeSource 绑不上，旋转根本不会生效。 -->
                                            <DataTrigger Binding="{Binding DataContext.Settings.IsVertical,
                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         Value="True">
                                                <Setter Property="Width" Value="4" />
                                                <Setter Property="Height" Value="13" />
                                            </DataTrigger>

                                            <!-- 停靠边不同，指示条落在图标哪一侧也不同（都用字面值，
                                                 避免绑定失败时回落到默认对齐，位置就跑了） -->
                                            <DataTrigger Binding="{Binding DataContext.Settings.Edge,
                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         Value="Top">
                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                <Setter Property="Margin" Value="0,-7.5,0,0" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding DataContext.Settings.Edge,
                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         Value="Left">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="-7.5,0,0,0" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding DataContext.Settings.Edge,
                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         Value="Right">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="0,0,-7.5,0" />
                                            </DataTrigger>

                                            <!-- 运行中：淡入 -->
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.16" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.14" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>

                                            <!-- 当前前台窗口：只把长度拉长，粗细不动。横排拉 Width，竖排拉 Height -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.Settings.IsVertical,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                             To="22" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                             To="13" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.Settings.IsVertical,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                             To="22" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                             To="13" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!-- 拖放插入指示：从桌面拖文件过来时，落点处竖一根亮条 -->
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="DropIndicator"
                           Width="3"
                           Height="{Binding Settings.ScaledIconSize}"
                           RadiusX="1.5" RadiusY="1.5"
                           Fill="#F2FFFFFF"
                           Visibility="Collapsed" />
            </Canvas>
        </Grid>

        <!-- 空状态 -->
        <TextBlock x:Name="EmptyHint"
                   Text="还没有图标，右键 → 添加应用"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />

    </Grid>
</Window>
