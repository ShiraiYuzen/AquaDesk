<Window x:Class="AquaDesk.Views.DragOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaDesk Drag"
        Width="400"
        Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="False">

    <!-- 拖动浮层。做成独立窗口而不是 Popup：
         指针拖到屏幕边缘时，Popup 会被系统做"边界修正"，浮层就和光标错开一段距离；
         普通窗口可以直接移到屏幕外，不会被动挪位置。 -->
    <Canvas x:Name="Root" IsHitTestVisible="False">
        <Image x:Name="Ghost" Opacity="0.92" />

        <Border x:Name="Hint"
                Visibility="Collapsed"
                Background="#E6323236"
                CornerRadius="10"
                Padding="12,5">
            <TextBlock Text="移除" Foreground="#FFFFFFFF" FontSize="12" />
        </Border>
    </Canvas>
</Window>
