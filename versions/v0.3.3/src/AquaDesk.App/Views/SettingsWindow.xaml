<Window x:Class="AquaDesk.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock 设置"
        Icon="pack://application:,,,/Assets/AquaDesk.ico"
        Width="828" Height="648"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        设置页 = 一张浮起来的卡片：
        无边框 + 外层圆角 + 投影，左边分类导航，右边按功能分组的白色卡片。
        分组逻辑跟 macOS 系统设置一致：标题（灰）+ 卡片（白，圆角，轻投影），
        每张卡片里的行用 1px 细线分隔。
    -->
    <Window.Resources>

        <!-- ============ 基础排版 ============ -->

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8A8A8E" />
            <Setter Property="Margin" Value="4,0,0,7" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8E" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#A0A0A5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <!-- 卡片：白色圆角 + 很轻的投影，浮在灰底上 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                      Opacity="0.07" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#EFEFF2" />
            <Setter Property="Margin" Value="14,0" />
        </Style>

        <!-- ============ iOS 风格开关 ============ -->

        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="42" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="12" Background="#D8D8DC" />
                                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.22" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#34C759" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单选行：左边文字、右边圆圈，整行都能点 -->
        <Style x:Key="RadioRow" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Row" CornerRadius="8" Background="Transparent" Padding="8,9">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" />

                                <Grid Width="18" Height="18"
                                      HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Stroke="#C7C7CC" StrokeThickness="1.4"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="Dot" Width="9" Height="9"
                                             Fill="#0A84FF" Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F4F4F6" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#0A84FF" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 滑块（细轨道 + 白色圆钮，替换系统那套 XP 观感） ============ -->

        <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#0A84FF"
                                VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1.2"
                                                      Opacity="0.3" Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Stroke="#D6D6DB" StrokeThickness="0.8" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#DCDCE1"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderTrackFill}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackEmpty}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 风格选择（两张可选卡片，取代 ComboBox） ============ -->

        <Style x:Key="StyleOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="10"
                                Background="#F7F7FA"
                                BorderBrush="#E4E4EA" BorderThickness="1.5"
                                Padding="12,12,12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C9C9D2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#0A84FF" />
                                <Setter TargetName="Box" Property="Background" Value="#F2F8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 按钮 ============ -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="#0A84FF"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0071E3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0063C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7"
                                Background="White" BorderBrush="#DCDCE1" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E9ED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 左上角三个窗口按钮（macOS 红绿灯） ============ -->
        <Style x:Key="TrafficDot" TargetType="Button">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="13" Height="13">
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter x:Name="Glyph"
                                              Visibility="Collapsed"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 左侧导航 ============ -->

        <Style x:Key="SidebarTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#5A5A5F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Row" CornerRadius="7" Margin="0,1"
                                Padding="11,7" Background="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#1C1C1E" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Row" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                          Opacity="0.1" Color="#000000" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTabControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 侧栏：圆角只做左边两角，右边跟内容区拼在一起 -->
                            <Border x:Name="SidebarBorder" Grid.Column="0" Background="#E9E9EE" CornerRadius="13,0,0,13">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="18,14,16,4"
                                                MouseLeftButtonDown="OnTitleBarDrag">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 关闭 -->
                                            <Button x:Name="CloseDot" Style="{StaticResource TrafficDot}"
                                                    Background="#FF5F57"
                                                    ToolTip="关闭" Click="OnClose">
                                                <Path Width="6" Height="6"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Data="M4.4,4.4 L8.6,8.6 M8.6,4.4 L4.4,8.6"
                                                      Stroke="#7A1B14" StrokeThickness="1"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Button>

                                            <!-- 最小化 -->
                                            <Button x:Name="MinButton" Style="{StaticResource TrafficDot}"
                                                    Background="#FEBC2E" Margin="8,0,0,0"
                                                    ToolTip="最小化" Click="OnMinimize">
                                                <Rectangle Width="6" Height="1.4" RadiusX="0.7" RadiusY="0.7"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Fill="#8A6A0B" />
                                            </Button>

                                            <!-- 最大化 / 还原 -->
                                            <Button x:Name="ZoomButton" Style="{StaticResource TrafficDot}"
                                                    Background="#28C840" Margin="8,0,0,0"
                                                    ToolTip="最大化 / 还原" Click="OnZoom">
                                                <Path Width="6" Height="6"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Data="M4,9 L9,4 M9,4 L5.9,4 M9,4 L9,7.1"
                                                      Stroke="#0B5A18" StrokeThickness="1"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Button>
                                        </StackPanel>

                                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#1C1C1E" Margin="0,12,0,0" />
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Margin="10,10,10,14">
                                        <!-- 用 StackPanel 当 items host：TabPanel 是给横向标签条排版的，
                                             侧栏要的是竖向列表 -->
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- 内容区 -->
                            <Border x:Name="ContentBorder" Grid.Column="1" Background="#F6F6F8" CornerRadius="0,13,13,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 顶部拖动条 -->
                                    <Border Grid.Row="0" Background="Transparent"
                                            MouseLeftButtonDown="OnTitleBarDrag" />

                                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />

                                    <!-- 底部固定条：所有分页共用，不用每页都放一遍 -->
                                    <Border Grid.Row="2" Background="#F6F6F8"
                                            BorderBrush="#EDEDF0" BorderThickness="0,1,0,0"
                                            Padding="24,12,24,16">
                                        <Grid>
                                            <Button Content="恢复默认" Padding="16,7"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="OnResetDefaults" />
                                            <Button Content="完成" Padding="26,7"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource PrimaryButton}"
                                                    IsDefault="True"
                                                    Click="OnClose" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层：整窗圆角 + 投影 + 一圈极淡的亮边（玻璃感）。
         Margin 留 14 是给投影的——窗口本身是透明画布，不留边阴影会被裁掉。 -->
    <Border x:Name="RootCard" Margin="14" CornerRadius="13" BorderThickness="1" BorderBrush="#33FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270"
                              Opacity="0.26" Color="#000000" />
        </Border.Effect>

        <TabControl x:Name="RootTabs"
                    Style="{StaticResource SidebarTabControl}"
                    TabStripPlacement="Left"
                    BorderThickness="0" Background="Transparent">

            <!-- ==================== 外观 ==================== -->
            <TabItem Header="外观" Style="{StaticResource SidebarTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,24">

                        <TextBlock Text="外观" FontSize="22" FontWeight="SemiBold" Foreground="#1C1C1E" />
                        <TextBlock Text="改完立即生效，配置自动保存" Style="{StaticResource Hint}" />

                        <TextBlock Text="界面风格" Style="{StaticResource SectionHeader}" Margin="4,22,0,7" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="14,14,14,14">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource StyleOption}"
                                                 GroupName="Style"
                                                 IsChecked="{Binding IsLiquid, Mode=OneWay}"
                                                 Click="OnStyleLiquid">
                                        <StackPanel Width="132">
                                            <Border Width="46" Height="46" CornerRadius="10"
                                                    HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#8FE3FF" Offset="0" />
                                                        <GradientStop Color="#2563EB" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="液态玻璃" FontWeight="SemiBold" Margin="0,9,0,0" />
                                            <TextBlock Text="折射 + 多层高光" FontSize="11"
                                                       Foreground="#8A8A8E" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton Style="{StaticResource StyleOption}"
                                                 GroupName="Style"
                                                 IsChecked="{Binding IsClassic, Mode=OneWay}"
                                                 Click="OnStyleClassic">
                                        <StackPanel Width="132">
                                            <Border Width="46" Height="46" CornerRadius="10"
                                                    HorizontalAlignment="Left"
                                                    Background="#D8DCE4" />
                                            <TextBlock Text="经典 0.01" FontWeight="SemiBold" Margin="0,9,0,0" />
                                            <TextBlock Text="四层玻璃，无折射" FontSize="11"
                                                       Foreground="#8A8A8E" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}"
                                           Text="切到经典会关掉抓屏折射，Dock 重新出现在截图和录屏里" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="液态玻璃" Style="{StaticResource SectionHeader}" Margin="4,4,0,7" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Margin="14,13,14,14">
                                    <Grid>
                                        <TextBlock Text="底板不透明度" Style="{StaticResource RowLabel}" />
                                        <TextBlock Style="{StaticResource ValueLabel}"
                                                   Text="{Binding GlassOpacity, StringFormat={}{0:F2}}" />
                                    </Grid>
                                    <Slider Style="{StaticResource MacSlider}"
                                            Minimum="0.05" Maximum="0.95" TickFrequency="0.01"
                                            Value="{Binding GlassOpacity, Mode=TwoWay}" />
                                    <TextBlock Text="越低越透，0.05 时几乎只剩一层高光"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,13,14,14">
                                    <Grid>
                                        <TextBlock Text="圆角半径" Style="{StaticResource RowLabel}" />
                                        <TextBlock Style="{StaticResource ValueLabel}"
                                                   Text="{Binding CornerRadius, StringFormat={}{0:F0} px}" />
                                    </Grid>
                                    <Slider Style="{StaticResource MacSlider}"
                                            Minimum="10" Maximum="44" TickFrequency="1"
                                            Value="{Binding CornerRadius, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Dock ==================== -->
            <TabItem Header="Dock" Style="{StaticResource SidebarTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,24">

                        <TextBlock Text="Dock" FontSize="22" FontWeight="SemiBold" Foreground="#1C1C1E" />
                        <TextBlock Text="尺寸、间距与悬停放大" Style="{StaticResource Hint}" />

                        <TextBlock Text="尺寸与间距" Style="{StaticResource SectionHeader}" Margin="4,22,0,7" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Margin="14,13,14,14">
                                    <Grid>
                                        <TextBlock Text="界面缩放" Style="{StaticResource RowLabel}" />
                                        <TextBlock Style="{StaticResource ValueLabel}"
                                                   Text="{Binding UiScalePercent, StringFormat={}{0:F0} %}" />
                                    </Grid>
                                    <Slider Style="{StaticResource MacSlider}"
                                            Minimum="80" Maximum="150" TickFrequency="5"
                                            Value="{Binding UiScalePercent, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,13,14,14">
                                    <Grid>
                                        <TextBlock Text="图标大小" Style="{StaticResource RowLabel}" />
                                        <TextBlock Style="{StaticResource ValueLabel}"
                                                   Text="{Binding IconSize, StringFormat={}{0:F0} px}" />
                                    </Grid>
                                    <Slider Style="{StaticResource MacSlider}"
                                            Minimum="36" Maximum="88" TickFrequency="1"
                                            Value="{Binding IconSize, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="6,6,6,6">
                                    <TextBlock Text="停靠位置" Style="{StaticResource RowLabel}" Margin="8,6,0,2" />

                                    <RadioButton GroupName="DockEdge" Style="{StaticResource RadioRow}"
                                                 Content="屏幕底部"
                                                 IsChecked="{Binding EdgeBottom, Mode=TwoWay}" />

                                    <RadioButton GroupName="DockEdge" Style="{StaticResource RadioRow}"
                                                 Content="屏幕顶部（菜单栏下方）"
                                                 IsChecked="{Binding EdgeTop, Mode=TwoWay}" />

                                    <RadioButton GroupName="DockEdge" Style="{StaticResource RadioRow}"
                                                 Content="屏幕左侧"
                                                 IsChecked="{Binding EdgeLeft, Mode=TwoWay}" />

                                    <RadioButton GroupName="DockEdge" Style="{StaticResource RadioRow}"
                                                 Content="屏幕右侧"
                                                 IsChecked="{Binding EdgeRight, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,13,14,14">
                                    <Grid>
                                        <TextBlock Text="图标间距" Style="{StaticResource RowLabel}" />
                                        <TextBlock Style="{StaticResource ValueLabel}"
                                                   Text="{Binding IconGap, StringFormat={}{0:F0} px}" />
                                    </Grid>
                                    <Slider Style="{StaticResource MacSlider}"
                                            Minimum="2" Maximum="20" TickFrequency="1"
                                            Value="{Binding IconGap, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,13,14,14">
                                    <Grid>
                                        <TextBlock Text="距屏幕边缘" Style="{StaticResource RowLabel}" />
                                        <TextBlock Style="{StaticResource ValueLabel}"
                                                   Text="{Binding BottomMargin, StringFormat={}{0:F0} px}" />
                                    </Grid>
                                    <Slider Style="{StaticResource MacSlider}"
                                            Minimum="0" Maximum="48" TickFrequency="1"
                                            Value="{Binding BottomMargin, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="悬停放大" Style="{StaticResource SectionHeader}" Margin="4,4,0,7" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="14,13,14,14">
                                <Grid>
                                    <TextBlock Text="最大放大倍数" Style="{StaticResource RowLabel}" />
                                    <TextBlock Style="{StaticResource ValueLabel}"
                                               Text="{Binding MagnifyMaxScale, StringFormat={}{0:F2} ×}" />
                                </Grid>
                                <Slider Style="{StaticResource MacSlider}"
                                        Minimum="1.0" Maximum="2.0" TickFrequency="0.05"
                                        Value="{Binding MagnifyMaxScale, Mode=TwoWay}" />
                                <TextBlock Text="1.00 表示关闭放大效果" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 图标 ==================== -->
            <TabItem Header="图标" Style="{StaticResource SidebarTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,24">

                        <TextBlock Text="图标" FontSize="22" FontWeight="SemiBold" Foreground="#1C1C1E" />
                        <TextBlock Text="决定 Dock 上显示哪些系统图标" Style="{StaticResource Hint}" />

                        <TextBlock Text="系统图标" Style="{StaticResource SectionHeader}" Margin="4,22,0,7" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="AquaDesk 图标" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding ShowBrandIcon, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="最左边那个，点它打开设置；关掉后右键玻璃条空白处照样能进"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="Windows 菜单图标" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding ShowWindowsIcon, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="左键点它弹出锁定 / 睡眠 / 关机 / 重启"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="启动台" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding ShowLaunchpadIcon, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="点它铺满全屏，按分类浏览所有应用"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="我的电脑" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding ShowComputerIcon, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="在启动台右边，点它直接打开「此电脑」"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="窗口预览" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding ShowWindowPreviews, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="在废纸篓左边显示当前打开的窗口缩略图，点一下切换前台 / 最小化"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="废纸篓" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding ShowTrashIcon, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="关掉时连同它前面的分隔线一起收起"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 系统 ==================== -->
            <TabItem Header="系统" Style="{StaticResource SidebarTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,24">

                        <TextBlock Text="系统" FontSize="22" FontWeight="SemiBold" Foreground="#1C1C1E" />
                        <TextBlock Text="开机自启与桌面接管，都在当前用户权限内完成" Style="{StaticResource Hint}" />

                        <TextBlock Text="系统集成" Style="{StaticResource SectionHeader}" Margin="4,22,0,7" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="开机自启" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="写进当前用户的 Run 项，可在「任务管理器 → 启动应用」里随时关掉"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="隐藏原生任务栏" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding HideTaskbar, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="彻底隐藏，鼠标移到底部也不会弹出；退出 AquaDesk 时会自动恢复"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardDivider}" />

                                <StackPanel Margin="14,12,14,12">
                                    <Grid>
                                        <TextBlock Text="隐藏桌面图标" Style="{StaticResource RowLabel}" />
                                        <CheckBox Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding HideDesktopIcons, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="只是把桌面图标层藏起来，文件一个都不会动；关掉开关立刻恢复"
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="性能" Style="{StaticResource SectionHeader}" Margin="4,4,0,7" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="6,6,6,6">
                                <RadioButton GroupName="PauseMode" Style="{StaticResource RadioRow}"
                                             Content="不暂停（一直保持液态玻璃）"
                                             IsChecked="{Binding PauseNever, Mode=TwoWay}" />

                                <RadioButton GroupName="PauseMode" Style="{StaticResource RadioRow}"
                                             Content="其他应用成为焦点时"
                                             IsChecked="{Binding PauseWhenUnfocused, Mode=TwoWay}" />

                                <RadioButton GroupName="PauseMode" Style="{StaticResource RadioRow}"
                                             Content="无边框全屏时（游戏那种）"
                                             IsChecked="{Binding PauseWhenBorderlessFullscreen, Mode=TwoWay}" />

                                <RadioButton GroupName="PauseMode" Style="{StaticResource RadioRow}"
                                             Content="全屏时（含浏览器 F11）"
                                             IsChecked="{Binding PauseWhenFullscreen, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Hint}" Margin="4,0,4,0"
                                   Text="暂停会停掉折射抓屏和状态轮询、丢掉缓冲，并把工作集还给系统；Dock 仍然显示，鼠标移到上面会立刻恢复。" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Border>
</Window>
