<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ========== 尺寸 token ========== -->
    <sys:Double x:Key="DockIconBox">52</sys:Double>

    <!-- ========== 液态玻璃：光学层 ==========
         真实玻璃在环境光下会同时出现这几种光：
         ① tint      底色薄雾（透明度可调）
         ② 顶部聚光  光从上方来，在顶边内侧积成一团，中间最亮、往两端散开
         ③ 顶边亮线  顶边那一道细锐的高光，往下迅速消失（这是"反光"最关键的信号）
         ④ 指针高光  跟随鼠标的一块镜面反光，像光在玻璃上滑动
         ⑤ 底部反光  光穿透玻璃后从底边内侧反弹回来的一层微光
         ⑥ sheen     斜向整体光泽，很淡，只用来统一色调
         ⑦ rim       一圈亮边，交代玻璃的厚度
         ⑧ 内阴影    底部压暗，做出体积
    -->

    <LinearGradientBrush x:Key="GlassTintBrush" StartPoint="0,0" EndPoint="0.15,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#D2E6EDF6" Offset="0.5" />
        <GradientStop Color="#B8DCE4F0" Offset="1" />
    </LinearGradientBrush>

    <!-- ② 顶部聚光：椭圆径向，中心压在顶边中点，往两端自然散开 -->
    <RadialGradientBrush x:Key="GlassTopGlowBrush"
                         Center="0.5,0" GradientOrigin="0.5,0"
                         RadiusX="0.62" RadiusY="0.78">
        <GradientStop Color="#5CFFFFFF" Offset="0" />
        <GradientStop Color="#2EFFFFFF" Offset="0.35" />
        <GradientStop Color="#0FFFFFFF" Offset="0.7" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <!-- ③ 顶边亮线：垂直渐变，顶边最亮，往下 15% 就基本消失 -->
    <LinearGradientBrush x:Key="GlassTopRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#D9FFFFFF" Offset="0.08" />
        <GradientStop Color="#4DFFFFFF" Offset="0.35" />
        <GradientStop Color="#0DFFFFFF" Offset="0.65" />
        <GradientStop Color="#1FFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ⑤ 底部反光 -->
    <LinearGradientBrush x:Key="GlassBottomBounceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
        <GradientStop Color="#12FFFFFF" Offset="0.86" />
        <GradientStop Color="#38FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ⑥ 斜向光泽 -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0.65,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#0FFFFFFF" Offset="0.3" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ⑦ 边缘 -->
    <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint="0.55,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#7AFFFFFF" Offset="0.4" />
        <GradientStop Color="#2EFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ⑧ 底部内阴影 -->
    <LinearGradientBrush x:Key="GlassInnerShadowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.5" />
        <GradientStop Color="#2408111F" Offset="1" />
    </LinearGradientBrush>

    <!-- 图标磁贴底板：统一成方形圆角，让不同来源的图标看起来是一套 -->
    <LinearGradientBrush x:Key="IconPlateBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#7AFFFFFF" Offset="0" />
        <GradientStop Color="#4DE3EAF4" Offset="1" />
    </LinearGradientBrush>

    <!-- ========== 图标上的玻璃层 ==========
         参考 iOS/macOS 的玻璃图标：每块图标都像压在一片玻璃下面。
         ① 斜向镜面 —— 左上角一块亮楔形，边界要稍微收得住，不然就是一层白雾
         ② 顶边亮线 —— 一道细高光贴着上边缘，往下迅速消失
         ③ 底部反弹 —— 底边内侧一点点微光，交代厚度
    -->

    <LinearGradientBrush x:Key="IconGlassSheenBrush" StartPoint="0,0" EndPoint="0.82,1">
        <GradientStop Color="#73FFFFFF" Offset="0" />
        <GradientStop Color="#59FFFFFF" Offset="0.30" />
        <GradientStop Color="#26FFFFFF" Offset="0.42" />
        <GradientStop Color="#00FFFFFF" Offset="0.58" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="IconGlassRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF" Offset="0" />
        <GradientStop Color="#66FFFFFF" Offset="0.22" />
        <GradientStop Color="#14FFFFFF" Offset="0.6" />
        <GradientStop Color="#33FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ========== 通用文字 ========== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="TextOnGlassBrush" Color="#F2FFFFFF" />

</ResourceDictionary>
