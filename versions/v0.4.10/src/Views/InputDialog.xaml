<Window x:Class="AquaDesk.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="392" Height="212"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="#0A84FF"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0071E3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0063C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7"
                                Background="White" BorderBrush="#DCDCE1" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 跟设置页同一套「浮起来的小卡片」：无边框 + 圆角 + 投影 -->
    <Border Margin="14" CornerRadius="12" Background="#FFFFFF"
            BorderThickness="1" BorderBrush="#1A000000">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                              Opacity="0.24" Color="#000000" />
        </Border.Effect>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Text="重命名"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1C1C1E"
                       MouseLeftButtonDown="OnTitleBarDrag" />

            <Border Grid.Row="1" Margin="0,14,0,0"
                    CornerRadius="8" Background="#F2F2F5"
                    BorderBrush="#DCDCE1" BorderThickness="1"
                    Padding="10,7">
                <TextBox x:Name="ValueBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#1C1C1E"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         TextChanged="OnValueChanged" />
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Padding="18,7" Margin="0,0,8,0"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="OnCancel" />
                <Button x:Name="OkButton" Content="确定" Padding="22,7"
                        Style="{StaticResource DialogPrimaryButton}"
                        IsDefault="True"
                        Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
