<Window x:Class="AquaDesk.Views.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动台"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        AllowDrop="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <ContextMenu x:Key="AppEntryMenu" x:Shared="False">
            <MenuItem Header="打开" Click="OnMenuOpenEntry" />
            <Separator />
            <MenuItem Header="从启动台移除" Click="OnMenuRemoveEntry" />
        </ContextMenu>

        <ContextMenu x:Key="FolderEntryMenu" x:Shared="False">
            <MenuItem Header="打开文件夹" Click="OnMenuOpenEntry" />
            <Separator />
            <MenuItem Header="解散文件夹" Click="OnMenuDissolveFolder" />
            <MenuItem Header="从启动台移除" Click="OnMenuRemoveEntry" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          MouseLeftButtonDown="OnRootMouseDown"
          AllowDrop="True"
          Drop="OnDropFiles"
          DragOver="OnDragOverFiles">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.32" GradientOrigin="0.5,0.32" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#F01B1F27" Offset="0" />
                <GradientStop Color="#F00A0B0E" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="60,32,60,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 顶栏：退出 + 返回 + 搜索 ============ -->
            <Grid Grid.Row="0" Margin="0,6,0,18">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                    <!-- 退出启动台 -->
                    <Button x:Name="ExitButton"
                            Content="退出 (esc)"
                            Cursor="Hand"
                            ToolTip="退出启动台"
                            Click="OnExitClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="9" Background="#26FFFFFF" Padding="14,8">
                                    <ContentPresenter TextBlock.Foreground="#F2FFFFFF"
                                                      TextBlock.FontSize="12.5"
                                                      HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BackButton"
                            Content="←  返回"
                            Visibility="Collapsed"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            Click="OnBackClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="9" Background="#26FFFFFF" Padding="14,8">
                                    <ContentPresenter TextBlock.Foreground="#F2FFFFFF"
                                                      TextBlock.FontSize="13" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <Border Width="380" Height="42"
                        CornerRadius="11"
                        Background="#2EFFFFFF"
                        BorderBrush="#3DFFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="搜索"
                                   Foreground="#66FFFFFF"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   IsHitTestVisible="False" />

                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F2FFFFFF"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 Margin="15,0,15,0"
                                 CaretBrush="White"
                                 TextChanged="OnSearchChanged" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 应用网格 ============ -->
            <Grid Grid.Row="1">
                <ItemsControl x:Name="AppGrid" VerticalAlignment="Top">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform x:Name="PageSlide" />
                    </ItemsControl.RenderTransform>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="4" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="122" Height="136"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  ToolTip="{Binding Name}"
                                  PreviewMouseLeftButtonDown="OnEntryMouseDown"
                                  MouseLeftButtonUp="OnEntryClick">

                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="ContextMenu" Value="{StaticResource AppEntryMenu}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="ContextMenu" Value="{StaticResource FolderEntryMenu}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- 悬停 / 拖拽落点高亮 -->
                                <Border CornerRadius="16" Margin="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1FFFFFFF" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="#3DFFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                    <Grid Height="74" Width="74">
                                        <!-- 应用图标 -->
                                        <Image Source="{Binding Icon}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding IsApp, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- 文件夹：2×2 缩略图 -->
                                        <Grid Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}">
                                            <Border CornerRadius="16" Background="#26FFFFFF" />
                                            <ItemsControl ItemsSource="{Binding Thumbnails}" Margin="9">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="2" Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding Icon}"
                                                               Margin="2"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#F2FFFFFF"
                                               FontSize="12"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,10,0,0"
                                               MaxWidth="112" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="StatusText"
                           Text="正在扫描已安装的应用…"
                           Foreground="#99FFFFFF"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />

                <!-- 拖拽落点指示：一根竖条，告诉用户松手会插到哪 -->
                <Canvas x:Name="DropLayer" IsHitTestVisible="False">
                    <Rectangle x:Name="DropBar"
                               Width="3"
                               Height="120"
                               RadiusX="1.5" RadiusY="1.5"
                               Fill="#F2FFFFFF"
                               Visibility="Collapsed" />
                </Canvas>

                <!-- 文件夹里往外拖时的提示 -->
                <Border x:Name="DragOutHint"
                        Visibility="Collapsed"
                        Background="#E6323236"
                        CornerRadius="10"
                        Padding="14,7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,10">
                    <TextBlock Text="松开移出文件夹" Foreground="#FFFFFFFF" FontSize="13" />
                </Border>
            </Grid>

            <!-- ============ 分页圆点 ============ -->
            <ItemsControl x:Name="PageDots"
                          Grid.Row="2"
                          HorizontalAlignment="Center"
                          Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="8" Height="8" Margin="5,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#40FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Fill" Value="#F2FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 拖拽浮层：启动台是全屏的，放在窗口里不会被裁 -->
        <Canvas x:Name="DragLayer" IsHitTestVisible="False">
            <Image x:Name="DragGhost"
                   Width="72" Height="72"
                   Opacity="0.85"
                   Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Canvas>
    </Grid>
</Window>
